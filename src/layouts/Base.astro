---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import '../styles/global.css';

/*
 * Cloudflare Web Analytics. Production builds only, and only when the token is
 * set — a missing token simply omits the beacon rather than failing the build.
 * `astro dev` never includes it, because import.meta.env.PROD is false there.
 * Set PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN as a GitHub Actions repository
 * variable; see the Analytics section of the README.
 */
const analyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN;
const showAnalytics = import.meta.env.PROD && Boolean(analyticsToken);

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <BaseHead {...Astro.props} />
    <script is:inline>
      // Applies the saved theme before first paint, so there is no flash of the
      // other one. Also marks that scripting is available, which reveals the toggle.
      (() => {
        document.documentElement.classList.add('has-js');
        try {
          const saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          // Storage unavailable: fall back to the OS preference.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>
    <Footer />
    {
      showAnalytics && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: analyticsToken })}
        />
      )
    }
  </body>
</html>
