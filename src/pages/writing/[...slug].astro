---
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Callout from '../../components/Callout.astro';
import Figure from '../../components/Figure.astro';
import Table from '../../components/Table.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getNotes, noteHref, readingTime } from '../../lib/notes';

export const getStaticPaths = (async () => {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

const { note } = Astro.props;
const { Content } = await render(note);
const related = note.data.related.length ? await getEntries(note.data.related) : [];
const links = note.data.links;
---

<Base
  title={note.data.title}
  description={note.data.description}
  image={note.data.image}
  type="article"
  publishedTime={note.data.published}
  modifiedTime={note.data.updated}
>
  <article>
    <header class="note-header">
      <h1>{note.data.title}</h1>
      <p class="description">{note.data.description}</p>
      <p class="meta">
        <FormattedDate date={note.data.published} />
        {note.data.updated && <FormattedDate date={note.data.updated} prefix="updated" />}
        <span>{readingTime(note.body)} min read</span>
        {note.data.tags.length > 0 && <span>{note.data.tags.join(', ')}</span>}
      </p>
    </header>

    <div class="prose">
      {/* Available in any .mdx note without importing them; `table` wraps Markdown tables. */}
      <Content components={{ Callout, Figure, table: Table }} />
    </div>

    {
      links && links.length > 0 && (
        <section class="endmatter">
          <h2 class="label">Related</h2>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="endmatter">
          <h2 class="label">Related notes</h2>
          <ul>
            {related.map((entry) => (
              <li>
                <a href={noteHref(entry.id)}>
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
