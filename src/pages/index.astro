---
import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import { HOME_NOTE_COUNT, INTRO, SITE } from '../consts';
import { getHomeNotes, getProjects } from '../lib/notes';

const notes = await getHomeNotes(HOME_NOTE_COUNT);
const projects = (await getProjects()).slice(0, 3);
---

<Base title={SITE.title} description={INTRO.line}>
  <div class="lede">
    <h1>Ryan Nel</h1>
    <p>{INTRO.who}</p>
    <p class="lede-sub">{INTRO.line}</p>
  </div>

  {/* A heading over nothing, above a link to an empty page, reads as a fault
      rather than as a site with nothing published yet. */}
  {
    notes.length > 0 && (
      <section class="section">
        <h2 class="label">Selected writing</h2>
        <NoteList notes={notes} showReadingTime={false} lead />
        <p class="section-more">
          <a href="/writing/">All writing</a>
        </p>
      </section>
    )
  }

  {
    projects.length > 0 && (
      <section class="section">
        <h2 class="label">Projects</h2>
        <ul class="note-list">
          {projects.map((project) => (
            <li>
              <a href={`/projects/#${project.id}`}>{project.data.name}</a>
              {/* The same class the notes above use: one description treatment,
                  so the two lists read as one page rather than two designs. */}
              <p class="note-description">{project.data.description}</p>
            </li>
          ))}
        </ul>
        <p class="section-more">
          <a href="/projects/">All projects</a>
        </p>
      </section>
    )
  }
</Base>
