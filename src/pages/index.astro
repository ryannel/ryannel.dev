---
import Base from '../layouts/Base.astro';
import NoteList from '../components/NoteList.astro';
import { ELSEWHERE, HOME_NOTE_COUNT, INTRO, SITE } from '../consts';
import { getHomeNotes, getProjects } from '../lib/notes';

const notes = await getHomeNotes(HOME_NOTE_COUNT);
const projects = (await getProjects()).slice(0, 3);
---

<Base title={SITE.title} description={INTRO.line}>
  <div class="lede">
    <h1>Ryan Nel</h1>
    <p>{INTRO.line}</p>
    <p>{INTRO.sub}</p>
  </div>

  <section class="section">
    <h2 class="label">Selected writing</h2>
    <NoteList notes={notes} showReadingTime={false} />
    <p class="section-more"><a href="/writing/">All writing</a></p>
  </section>

  <section class="section">
    <h2 class="label">Projects</h2>
    <ul class="note-list">
      {
        projects.map((project) => (
          <li>
            <a href={`/projects/#${project.id}`}>{project.data.name}</a>
            <p>{project.data.description}</p>
          </li>
        ))
      }
    </ul>
    <p class="section-more"><a href="/projects/">All projects</a></p>
  </section>

  <section class="section">
    <h2 class="label">Elsewhere</h2>
    <p class="inline-links">
      {
        ELSEWHERE.map((link, i) => (
          <>
            {i > 0 && ' · '}
            <a href={link.href} rel="me">
              {link.label}
            </a>
          </>
        ))
      }
      {' · '}<a href="/rss.xml">RSS</a>
    </p>
  </section>
</Base>
