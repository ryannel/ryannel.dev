---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import { HOME_PROJECT_COUNT, INTRO, SITE } from '../consts';
import { getHomeProjects, getProjects } from '../lib/projects';

const projects = await getHomeProjects(HOME_PROJECT_COUNT);
const total = (await getProjects()).length;
---

<Base title={SITE.title} description={INTRO.line}>
  <div class="lede">
    <h1>Ryan Nel</h1>
    <p>{INTRO.who}</p>
    <p class="lede-sub">{INTRO.line}</p>
  </div>

  {/* A heading over nothing reads as a fault rather than as a site with
      nothing published yet. */}
  {
    projects.length > 0 && (
      <section class="section">
        <h2 class="label">Recent projects</h2>
        <ProjectList projects={projects} showReadingTime={false} lead />
        {total > projects.length && (
          <p class="section-more">
            <a href="/projects/">All projects</a>
          </p>
        )}
      </section>
    )
  }
</Base>
