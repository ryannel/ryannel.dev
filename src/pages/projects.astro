---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getProjects, noteHref, resolveNotes } from '../lib/notes';

const projects = await getProjects();

const rendered = await Promise.all(
  projects.map(async (project) => ({
    project,
    Content: (await render(project)).Content,
    related: await resolveNotes(project.data.related),
  })),
);
---

<Base
  title="Projects"
  description="A small selection of things I’m building, and what each one is for."
>
  <h1 class="page-title">Projects</h1>
  <p class="page-intro">
    A few things I’m building. Not everything I’ve ever pushed to GitHub — just the work that’s
    going somewhere.
  </p>

  {
    rendered.map(({ project, Content, related }) => (
      <section class="project" id={project.id}>
        <h2>{project.data.name}</h2>
        <p class="status">{project.data.status}</p>
        <div class="prose">
          <Content />
        </div>
        {project.data.links && project.data.links.length > 0 && (
          <p class="links">
            {project.data.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </p>
        )}
        {/*
          Labelled, because an unannounced second row of links below "GitHub"
          reads as more of the same thing. These are note titles, not places to
          inspect the project. The row is absent entirely when every reference
          resolves to something this build does not publish.
        */}
        {related.length > 0 && (
          <>
            <h3 class="label project-related-heading">Related notes</h3>
            <ul class="project-related">
              {related.map((note) => (
                <li>
                  <a href={noteHref(note.id)}>{note.data.title}</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    ))
  }
</Base>
