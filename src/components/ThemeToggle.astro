---
/**
 * Cycles system → light → dark → system.
 *
 * "System" is the default and stores nothing; the other two write to localStorage.
 * Which icon shows is decided in CSS from data-theme, so the script only ever sets
 * one attribute. The button is hidden unless the inline script in Base.astro ran,
 * so it never appears as a dead control when JavaScript is unavailable.
 */
---

<button class="theme-toggle" type="button" aria-label="Theme: system. Change theme.">
  <svg class="icon-system" viewBox="0 0 16 16" width="16" height="16" fill="none"
    stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"
    aria-hidden="true">
    <rect x="1.7" y="2.7" width="12.6" height="8.8" rx="1.2"></rect>
    <path d="M5.6 14h4.8"></path>
  </svg>
  <svg class="icon-light" viewBox="0 0 16 16" width="16" height="16" fill="none"
    stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true">
    <circle cx="8" cy="8" r="3.1"></circle>
    <path
      d="M8 1.3v1.5M8 13.2v1.5M14.7 8h-1.5M2.8 8H1.3M12.7 3.3l-1.1 1.1M4.4 11.6l-1.1 1.1M12.7 12.7l-1.1-1.1M4.4 4.4L3.3 3.3"
    ></path>
  </svg>
  <svg class="icon-dark" viewBox="0 0 16 16" width="16" height="16" fill="none"
    stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true">
    <path d="M13.4 9.8A6 6 0 0 1 6.2 2.6a6 6 0 1 0 7.2 7.2z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('.theme-toggle');
    if (!button) return;

    const ORDER = ['system', 'light', 'dark'];
    const PAPER = { light: '#fdfcfa', dark: '#141413' };
    const dark = matchMedia('(prefers-color-scheme: dark)');
    const describe = (theme) => `Theme: ${theme}. Change theme.`;

    // The static pair in <head> is media-scoped and correct without scripting,
    // but the spec picks the FIRST matching meta, so a manual override cannot
    // simply be appended. Replace them with one meta this script owns.
    document.querySelectorAll('meta[name="theme-color"]').forEach((m) => m.remove());
    const meta = document.createElement('meta');
    meta.name = 'theme-color';
    document.head.appendChild(meta);

    const paint = () => {
      meta.content = PAPER[root.dataset.theme || (dark.matches ? 'dark' : 'light')];
    };

    const apply = (theme) => {
      if (theme === 'system') delete root.dataset.theme;
      else root.dataset.theme = theme;
      try {
        if (theme === 'system') localStorage.removeItem('theme');
        else localStorage.setItem('theme', theme);
      } catch {
        // Private browsing or blocked storage: the choice just won't outlive the page.
      }
      button.setAttribute('aria-label', describe(theme));
      button.title = describe(theme);
      paint();
    };

    apply(root.dataset.theme || 'system');
    // Keeps the browser chrome correct when the OS flips while System is selected.
    dark.addEventListener('change', paint);
    button.addEventListener('click', () => {
      const current = root.dataset.theme || 'system';
      apply(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length]);
    });
  })();
</script>
