---
import '../../styles/hitl.css';

/**
 * The one picture the big-companies note keeps coming back to: a product card
 * saying "Arrives in 3–5 days", with what that line depends on drawn underneath.
 * Each section of the note shows it again at a later stage.
 *
 *  1. The card on its own.
 *  2. The small shop: a shelf and the post office. Selling the last kettle
 *     turns the line into "Out of stock".
 *  3. Orders flowing through, a few of them late. The slider goes from corner
 *     shop to big company: orders come faster, the shelf splits into the
 *     places stock really sits, more of the dates are wrong, and the late ones
 *     pile up as calls, refunds and lost customers.
 *
 * Every rate is invented; it's a sketch of the shape, not a measurement.
 */
interface Props {
  stage: 1 | 2 | 3;
}
const { stage } = Astro.props;

const aria = {
  1: 'A product card for a blue kettle, priced at £39, with the line "Arrives in 3–5 days".',
  2: 'The kettle card above two boxes it depends on: a shelf holding a few kettles, and the post office.',
  3: 'Orders flow from the kettle card through the places its stock is kept to the customer. Some arrive late and pile up as calls, refunds and lost customers.',
}[stage];

const caption = {
  1: 'The line we’ll follow through the rest of this note.',
  2: 'Everything the small shop needs to know to show a delivery date. Sell kettles to see the line change.',
  3: 'Each envelope is an order, and a red one arrived later than the page promised. Slide from corner shop to big company. A sketch with invented rates.',
}[stage];
---

<figure class="hitl slow-chain" data-slow-chain data-stage={stage}>
  <div class="hitl-stage">
    <canvas class="slow-canvas" aria-label={aria}></canvas>
    <noscript><p class="hitl-note">The figure is drawn with JavaScript.</p></noscript>
  </div>
  {stage === 2 && (
    <div class="hitl-controls">
      <button type="button" data-sell>Sell one</button>
      <button type="button" data-restock>Restock</button>
    </div>
  )}
  {stage === 3 && (
    <div class="hitl-controls">
      <span class="hitl-note" aria-hidden="true">Corner shop</span>
      <input type="range" min="0" max="100" step="1" value="0" aria-label="From corner shop to big company" />
      <span class="hitl-note" aria-hidden="true">Big company</span>
    </div>
  )}
  {stage === 3 && <p class="hitl-readout" aria-live="polite"></p>}
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .slow-chain .hitl-stage {
    padding: 0;
    overflow: hidden;
  }
  .slow-canvas {
    display: block;
    width: 100%;
  }
  .slow-chain input[type='range'] {
    flex: 1;
    min-width: 8rem;
  }
</style>

<script>
  import { mulberry, theme, fit, animate, label, reducedMotion, NARROW, type Colours } from './canvas';

  type Pt = { x: number; y: number };
  type Box = { x: number; y: number; w: number; h: number };

  const centre = (b: Box): Pt => ({ x: b.x + b.w / 2, y: b.y + b.h / 2 });
  const lerp = (a: Pt, b: Pt, t: number): Pt => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });
  const ease = (t: number) => t * t * (3 - 2 * t);

  /** Red that reads on either paper. */
  const lateColour = (c: Colours) => {
    const [r, g, b] = (c.paper.match(/\d+/g) ?? ['255', '255', '255']).map(Number);
    return r + g + b < 384 ? '#e57373' : '#c0392b';
  };

  function roundRect(ctx: CanvasRenderingContext2D, b: Box, r: number) {
    ctx.beginPath();
    ctx.roundRect(b.x, b.y, b.w, b.h, r);
  }

  function box(ctx: CanvasRenderingContext2D, c: Colours, px: number, b: Box, title: string, note?: string) {
    roundRect(ctx, b, 6 * px);
    ctx.fillStyle = c.paper;
    ctx.fill();
    ctx.strokeStyle = c.muted;
    ctx.lineWidth = 1.5 * px;
    ctx.stroke();
    ctx.font = `600 ${13 * px}px ${c.font}`;
    ctx.textBaseline = 'middle';
    const p = centre(b);
    label(ctx, c, px, title, p.x, note ? b.y + 16 * px : p.y, c.ink);
    if (note) {
      ctx.font = `${12 * px}px ${c.font}`;
      label(ctx, c, px, note, p.x, b.y + b.h - 14 * px, c.muted);
    }
  }

  function kettle(ctx: CanvasRenderingContext2D, colour: string, x: number, y: number, s: number) {
    // A squat body, a spout to the left, a handle to the right, a lid knob.
    ctx.fillStyle = colour;
    ctx.strokeStyle = colour;
    ctx.lineWidth = s * 0.12;
    ctx.beginPath();
    ctx.moveTo(x - s * 0.45, y + s * 0.4);
    ctx.lineTo(x + s * 0.45, y + s * 0.4);
    ctx.lineTo(x + s * 0.35, y - s * 0.25);
    ctx.lineTo(x - s * 0.35, y - s * 0.25);
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(x - s * 0.38, y);
    ctx.lineTo(x - s * 0.62, y - s * 0.22);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(x + s * 0.42, y + s * 0.05, s * 0.22, -Math.PI / 2, Math.PI / 2);
    ctx.stroke();
    ctx.beginPath();
    ctx.arc(x, y - s * 0.33, s * 0.08, 0, Math.PI * 2);
    ctx.fill();
  }

  /** The product card, with the line it's all about. */
  function card(ctx: CanvasRenderingContext2D, c: Colours, px: number, b: Box, line: string, lineColour: string) {
    roundRect(ctx, b, 10 * px);
    ctx.fillStyle = c.paper;
    ctx.fill();
    ctx.strokeStyle = c.rule;
    ctx.lineWidth = 1.5 * px;
    ctx.stroke();
    const s = Math.min(b.h * 0.5, 46 * px);
    kettle(ctx, c.accent, b.x + 20 * px + s * 0.6, b.y + b.h / 2, s);
    const tx = b.x + 32 * px + s * 1.2;
    ctx.textBaseline = 'middle';
    ctx.font = `600 ${15 * px}px ${c.font}`;
    label(ctx, c, px, 'Blue kettle', tx, b.y + b.h * 0.27, c.ink, 'left');
    ctx.font = `${13 * px}px ${c.font}`;
    label(ctx, c, px, '£39', tx, b.y + b.h * 0.5, c.muted, 'left');
    ctx.font = `600 ${14 * px}px ${c.font}`;
    label(ctx, c, px, line, tx, b.y + b.h * 0.75, lineColour, 'left');
  }

  function envelope(ctx: CanvasRenderingContext2D, colour: string, p: Pt, px: number, alpha = 1) {
    const w = 16 * px;
    const h = 11 * px;
    ctx.globalAlpha = alpha;
    ctx.fillStyle = colour;
    ctx.fillRect(p.x - w / 2, p.y - h / 2, w, h);
    ctx.strokeStyle = 'rgba(255,255,255,0.7)';
    ctx.lineWidth = 1 * px;
    ctx.beginPath();
    ctx.moveTo(p.x - w / 2, p.y - h / 2);
    ctx.lineTo(p.x, p.y + h * 0.1);
    ctx.lineTo(p.x + w / 2, p.y - h / 2);
    ctx.stroke();
    ctx.globalAlpha = 1;
  }

  function wire(ctx: CanvasRenderingContext2D, c: Colours, px: number, a: Pt, b: Pt) {
    ctx.strokeStyle = c.rule;
    ctx.lineWidth = 1.5 * px;
    ctx.beginPath();
    ctx.moveTo(a.x, a.y);
    ctx.lineTo(b.x, b.y);
    ctx.stroke();
  }

  for (const figure of document.querySelectorAll<HTMLElement>('[data-slow-chain]')) {
    const stage = Number(figure.dataset.stage);
    const canvas = figure.querySelector<HTMLCanvasElement>('.slow-canvas')!;
    const reduced = reducedMotion();
    let narrow = false;

    const layout = (w: number) => {
      narrow = w < NARROW;
      // Heights are in CSS pixels, so the boxes and text, which are sized in CSS pixels too, always fit.
      const W = narrow ? 600 : 1000;
      const cssH = stage === 1 ? 170 : stage === 2 ? 360 : narrow ? 630 : 470;
      return { W, H: (W / w) * cssH };
    };

    let draw = () => {};
    const c = theme(figure, () => draw());
    const { ctx, view, clear } = fit(canvas, layout, () => draw());

    /** The card's box, sized in CSS pixels so its text always fits. */
    const cardBox = (cx: number, top: number, cw = 280, ch = 110): Box => {
      const w = cw * view.px;
      const h = ch * view.px;
      return { x: cx - w / 2, y: top, w, h };
    };

    if (stage === 1) {
      draw = () => {
        clear(c.paper);
        const b = cardBox(view.W / 2, 0);
        b.y = (view.H - b.h) / 2;
        card(ctx, c, view.px, b, 'Arrives in 3–5 days', c.accent);
      };
      draw();
      continue;
    }

    if (stage === 2) {
      const MAX = 3;
      let stock = MAX;
      /** Kettles on their way from the shelf to the post office, 0 → 1. */
      let moving: number[] = [];
      const sell = figure.querySelector<HTMLButtonElement>('[data-sell]')!;
      const restock = figure.querySelector<HTMLButtonElement>('[data-restock]')!;

      const boxes = () => {
        const px = view.px;
        const w = (narrow ? 140 : 200) * px;
        const h = 96 * px;
        const top = (40 + 110 + 70) * px;
        const gap = narrow ? 24 * px : 120 * px;
        return {
          card: cardBox(view.W / 2, 40 * px),
          shelf: { x: view.W / 2 - gap / 2 - w, y: top, w, h },
          post: { x: view.W / 2 + gap / 2, y: top, w, h },
        };
      };

      draw = () => {
        const px = view.px;
        clear(c.paper);
        const { card: cb, shelf, post } = boxes();
        const lineY = cb.y + cb.h;
        wire(ctx, c, px, { x: cb.x + cb.w * 0.35, y: lineY }, { x: centre(shelf).x, y: shelf.y });
        wire(ctx, c, px, { x: cb.x + cb.w * 0.65, y: lineY }, { x: centre(post).x, y: post.y });
        card(ctx, c, px, cb, stock > 0 ? 'Arrives in 3–5 days' : 'Out of stock', stock > 0 ? c.accent : c.muted);
        box(ctx, c, px, shelf, 'Shelf', stock > 0 ? `${stock} left` : 'empty');
        box(ctx, c, px, post, 'Post office', 'about 2 days');
        const s = 22 * px;
        for (let i = 0; i < stock; i++) kettle(ctx, c.accent, centre(shelf).x + (i - (stock - 1) / 2) * s * 1.8, centre(shelf).y + 2 * px, s);
        for (const t of moving) {
          const a = { x: centre(shelf).x, y: centre(shelf).y };
          const b = { x: post.x + post.w + 60 * px, y: centre(post).y };
          const p = lerp(a, b, ease(t));
          ctx.globalAlpha = t > 0.85 ? (1 - t) / 0.15 : 1;
          kettle(ctx, c.accent, p.x, p.y - Math.sin(t * Math.PI) * 50 * px, s);
          ctx.globalAlpha = 1;
        }
        sell.disabled = stock === 0;
      };

      sell.addEventListener('click', () => {
        if (stock === 0) return;
        stock--;
        if (!reduced) moving.push(0);
        draw();
      });
      restock.addEventListener('click', () => {
        stock = MAX;
        draw();
      });
      animate(figure, (dt) => {
        if (!moving.length) return;
        moving = moving.map((t) => t + dt / 1100).filter((t) => t < 1);
        draw();
      });
      draw();
      continue;
    }

    // Stage 3: orders flowing through, some of them late.
    const slider = figure.querySelector<HTMLInputElement>('input[type="range"]')!;
    const readout = figure.querySelector<HTMLElement>('.hitl-readout')!;
    const rand = mulberry(3);
    const PILES = ['Calls', 'Refunds', 'Lost customers'];
    const PLACES = [['Shelf'], ['Factory', 'Warehouse'], ['Suppliers', 'Factory', 'Freight', 'Warehouse', 'Retailer']];
    const LIFE = 14000; // ms a late order stays on its pile, so the piles show how often it happens now
    let scale = 0;
    let clock = 0;
    let due = 0;

    interface Order {
      place: number;
      t: number; // 0 → 1 along card → place → customer
      late: boolean;
      pile: number;
      fall: number; // 0 → 1 from customer to pile, once late
    }
    let orders: Order[] = [];
    /** Each pile's late orders, by when they landed. */
    let piles: number[][] = PILES.map(() => []);

    const places = () => PLACES[scale < 0.34 ? 0 : scale < 0.67 ? 1 : 2];
    /** Orders a second, and the chance any one is late: both grow with the company. */
    const rate = () => 0.7 + scale * 11;
    const lateChance = () => [0.05, 0.1, 0.14][scale < 0.34 ? 0 : scale < 0.67 ? 1 : 2];

    const geometry = () => {
      const px = view.px;
      const names = places();
      const bw = (narrow ? 96 : 130) * px;
      const bh = 40 * px;
      if (narrow) {
        // Up to three places a row, each row centred.
        const cb = cardBox(view.W / 2, 24 * px, 230, 100);
        const top = cb.y + cb.h + 70 * px;
        const gap = 14 * px;
        const placeBoxes = names.map((_, i) => {
          const row = Math.floor(i / 3);
          const inRow = Math.min(3, names.length - row * 3);
          const total = inRow * bw + (inRow - 1) * gap;
          return { x: view.W / 2 - total / 2 + (i % 3) * (bw + gap), y: top + row * (bh + 14 * px), w: bw, h: bh };
        });
        const bottom = Math.max(...placeBoxes.map((b) => b.y + b.h));
        const customer = { x: view.W / 2 - bw / 2, y: bottom + 70 * px, w: bw, h: bh };
        const base = view.H - 50 * px;
        const pileX = PILES.map((_, i) => view.W / 2 + (i - 1) * 110 * px);
        return { cb, placeBoxes, customer, base, pileX, vertical: true };
      }
      const cb = cardBox(20 * px + 115 * px, 0, 230, 100);
      cb.y = 160 * px - cb.h / 2;
      const midY = 160 * px;
      const spread = 54 * px;
      const placeBoxes = names.map((_, i) => ({ x: view.W * 0.56 - bw / 2, y: midY + (i - (names.length - 1) / 2) * spread - bh / 2, w: bw, h: bh }));
      const customer = { x: view.W - 20 * px - bw, y: midY - bh / 2, w: bw, h: bh };
      const base = view.H - 40 * px;
      const pileX = PILES.map((_, i) => view.W * 0.6 + (i - 1) * 130 * px);
      return { cb, placeBoxes, customer, base, pileX, vertical: false };
    };

    /** Where an order is, from the card through its place to the customer. */
    const along = (g: ReturnType<typeof geometry>, o: Order): Pt => {
      const pb = g.placeBoxes[Math.min(o.place, g.placeBoxes.length - 1)];
      const start = g.vertical ? { x: centre(g.cb).x, y: g.cb.y + g.cb.h } : { x: g.cb.x + g.cb.w, y: centre(g.cb).y };
      const inn = g.vertical ? { x: centre(pb).x, y: pb.y } : { x: pb.x, y: centre(pb).y };
      const out = g.vertical ? { x: centre(pb).x, y: pb.y + pb.h } : { x: pb.x + pb.w, y: centre(pb).y };
      const end = g.vertical ? { x: centre(g.customer).x, y: g.customer.y } : { x: g.customer.x, y: centre(g.customer).y };
      if (o.t < 0.4) return lerp(start, inn, o.t / 0.4);
      if (o.t < 0.55) return lerp(inn, out, (o.t - 0.4) / 0.15);
      return lerp(out, end, (o.t - 0.55) / 0.45);
    };

    const pileTop = (g: ReturnType<typeof geometry>, i: number, n: number): Pt => {
      const px = view.px;
      const per = 4;
      return { x: g.pileX[i] + ((n % per) - (per - 1) / 2) * 18 * px, y: g.base - 26 * px - Math.floor(n / per) * 13 * px };
    };

    draw = () => {
      const px = view.px;
      const g = geometry();
      const late = lateColour(c);
      clear(c.paper);
      for (const pb of g.placeBoxes) {
        const a = g.vertical ? { x: centre(g.cb).x, y: g.cb.y + g.cb.h } : { x: g.cb.x + g.cb.w, y: centre(g.cb).y };
        const b = g.vertical ? { x: centre(pb).x, y: pb.y } : { x: pb.x, y: centre(pb).y };
        const d = g.vertical ? { x: centre(g.customer).x, y: g.customer.y } : { x: g.customer.x, y: centre(g.customer).y };
        const e = g.vertical ? { x: centre(pb).x, y: pb.y + pb.h } : { x: pb.x + pb.w, y: centre(pb).y };
        wire(ctx, c, px, a, b);
        wire(ctx, c, px, e, d);
      }
      // Orders on their way pass behind the boxes, so the labels stay readable.
      for (const o of orders)
        if (o.fall === 0) envelope(ctx, o.late && o.t > 0.75 ? late : c.muted, along(g, o), px, o.t > 0.95 && !o.late ? (1 - o.t) / 0.05 : 1);
      card(ctx, c, px, g.cb, 'Arrives in 3–5 days', c.accent);
      places().forEach((name, i) => box(ctx, c, px, g.placeBoxes[i], name));
      box(ctx, c, px, g.customer, 'Customer');

      // Piles of late orders, with their labels.
      ctx.font = `${12 * px}px ${c.font}`;
      ctx.textBaseline = 'middle';
      PILES.forEach((name, i) => {
        ctx.strokeStyle = c.rule;
        ctx.lineWidth = 1.5 * px;
        ctx.beginPath();
        ctx.moveTo(g.pileX[i] - 46 * px, g.base - 16 * px);
        ctx.lineTo(g.pileX[i] + 46 * px, g.base - 16 * px);
        ctx.stroke();
        label(ctx, c, px, name, g.pileX[i], g.base, c.muted);
        piles[i].forEach((born, n) => {
          const age = clock - born;
          envelope(ctx, late, pileTop(g, i, n), px, age > LIFE - 1500 ? Math.max(0, (LIFE - age) / 1500) : 1);
        });
      });

      for (const o of orders) {
        if (o.fall === 0) continue;
        const from = { x: centre(g.customer).x, y: g.customer.y + g.customer.h };
        envelope(ctx, late, lerp(from, pileTop(g, o.pile, piles[o.pile].length), ease(o.fall)), px);
      }
    };

    const describe = () => {
      readout.textContent =
        scale < 0.34
          ? 'A corner shop. Now and then an order arrives late, and one customer gets an apology.'
          : scale < 0.67
            ? 'Bigger. More orders, stock in more than one place, and the late ones start to add up.'
            : 'A big company. The same rough answer, wrong a little more often, across far more orders: a steady stream of calls, refunds and customers who don’t come back.';
    };

    /** For reduced motion: a still picture with piles as they'd be after a while. */
    const settle = () => {
      orders = [];
      piles = PILES.map(() => []);
      const n = Math.round((rate() * lateChance() * LIFE) / 1000);
      for (let k = 0; k < n; k++) piles[k % 3].push(clock);
    };

    slider.addEventListener('input', () => {
      scale = Number(slider.value) / 100;
      for (const o of orders) o.place = Math.min(o.place, places().length - 1);
      describe();
      if (reduced) settle();
      draw();
    });

    animate(figure, (dt) => {
      clock += dt;
      due -= dt;
      while (due <= 0) {
        const late = rand() < lateChance();
        orders.push({ place: Math.floor(rand() * places().length), t: 0, late, pile: Math.floor(rand() * 3), fall: 0 });
        due += (-Math.log(1 - rand()) * 1000) / rate();
      }
      const speed = dt / 2600;
      for (const o of orders) {
        if (o.fall > 0) o.fall += dt / 700;
        else o.t += speed;
        if (o.late && o.t >= 1 && o.fall === 0) o.fall = 0.001;
      }
      for (const o of orders) if (o.fall >= 1) piles[o.pile].push(clock);
      orders = orders.filter((o) => (o.late ? o.fall < 1 : o.t < 1));
      piles = piles.map((p) => p.filter((born) => clock - born < LIFE).slice(-24));
      draw();
    });

    describe();
    if (reduced) settle();
    draw();
  }
</script>
