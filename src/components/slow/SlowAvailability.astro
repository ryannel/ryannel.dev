---
import '../../styles/hitl.css';
import './loop.css';
---
<figure class="hitl slow-loop logistics" data-logistics>
  <div class="hitl-stage">
    <p class="scene-title">What a delivery date depends on</p>
    <button class="loop-pause" data-pause-loop type="button" aria-label="Pause animation" aria-pressed="false">Ⅱ</button>
    <canvas role="img" aria-label="Five warehouses and three boats serve different orders. One customer stays fixed. When the local depot empties, stock is transferred from the South depot. Once that stock is used, a new order waits for an incoming shipment to clear customs. North depot stock is already reserved for other customers. Orange shows the route behind the current delivery estimate."></canvas>
    <div class="estimate">
      <div><span class="eyebrow">The estimate we want the website to give</span><strong data-estimate>Arrives in 3–5 days</strong></div>
      <p data-source>From the local warehouse.</p>
    </div>
    <noscript><p>When local stock runs out, stock can be transferred from the South depot. If both are empty, new orders wait for the incoming shipment. Stock at the North depot is already reserved for other customers.</p></noscript>
  </div>
  <figcaption>For the same customer ordering at different moments, the answer changes. Orange traces the stock behind each estimate; other shipments serve other orders. A fictional network, with invented stock and delivery times.</figcaption>
</figure>
<style>
  .logistics .hitl-stage { border-radius: 1rem; box-shadow: 0 12px 32px light-dark(#354c3510, #00000024); }
  .scene-title { position: absolute; top: 1rem; left: 1.25rem; margin: 0; font-size: 0.875rem; font-weight: 600; color: var(--ink); }
  .logistics canvas { aspect-ratio: 775 / 520; }
  .estimate { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--rule); margin: 0; padding: 1.1rem 1.25rem 1.25rem; background: linear-gradient(110deg, light-dark(#f6ecdc, #24281f), transparent); min-height: 5.5rem; box-sizing: border-box; }
  .eyebrow { display: block; color: var(--ink-muted); font-size: 0.6875rem; letter-spacing: 0.035em; margin-bottom: 0.35rem; }
  .estimate strong { display: block; font-size: 1.25rem; color: var(--ink); font-weight: 600; letter-spacing: -0.025em; }
  .estimate p { margin: 0; color: var(--ink-muted); font-size: 0.8125rem; max-width: 15rem; }
  @media (max-width: 560px) {
    .logistics canvas { aspect-ratio: 350 / 600; }
    .estimate { display: block; min-height: 8.25rem; padding: 1rem; }
    .estimate p { margin-top: 0.5rem; max-width: none; }
    .scene-title { left: 1rem; }
  }
</style>
<script>
  import { theme, fit, ball, isDark, HUES } from './canvas';
  import { scenery, artwork } from './logistics-art';
  import { loop, ease, clamp } from './loop';
  import { DURATION, networkAt, movements, type Location, type Movement } from './logistics-model';
  type Point = { x: number; y: number };
  type Route = [Point, Point, Point];
  const mix = (a: Point, b: Point, p: number): Point => ({ x: a.x + (b.x - a.x) * p, y: a.y + (b.y - a.y) * p });
  const along = ([a, b, c]: Route, p: number) => mix(mix(a, b, p), mix(b, c, p), p);
  for (const figure of document.querySelectorAll<HTMLElement>('[data-logistics]')) {
    let time = 0;
    let draw = () => {};
    let lastSource = '';
    const estimate = figure.querySelector<HTMLElement>('[data-estimate]')!;
    const sourceText = figure.querySelector<HTMLElement>('[data-source]')!;
    const c = theme(figure, () => draw());
    const { ctx, view, clear } = fit(figure.querySelector('canvas')!, width => ({ W: width, H: width < 560 ? 600 : 520 }), () => draw());
    draw = () => {
      clear(c.paper);
      const w = view.W, h = view.H, narrow = w < 560;
      const dark = isDark(c);
      const teal = dark ? '#8bd6c2' : '#4aab98';
      const grey = dark ? '#a8b5d4' : '#8e9ebc';
      const orange = HUES.ours[dark ? 1 : 0];
      const land = dark ? '#344c45' : '#e3edcc';
      const coast = dark ? '#4a6254' : '#bdcbaa';
      const seaLine = dark ? '#82aeb238' : '#719da955';
      const art = artwork(ctx,dark);
      const labelInk = dark ? '#dbe4d4' : '#3d5147';
      const state = networkAt(time);
      const r = narrow ? 3.6 : 4.7;
      const scale = narrow ? 0.85 : 1.08;
      const P = (x: number, y: number): Point => ({ x: w * x, y: h * y });
      const nodes = { origin: P(.14,.46), west: P(.16,.81), north: P(.82,.22), local: P(.84,.64), south: P(.61,.88), customs: P(.68,.43) };
      const factory = P(.14,.22), customer = P(.9,.9);
      const sea: Record<'main' | 'retail' | 'away', Route> = {
        main: [P(.30,.47), P(.44,.34), P(.56,.43)],
        retail: [P(.31,.79), P(.48,.45), P(.66,.22)],
        away: [P(.30,.54), P(.42,.77), P(.48,1.08)],
      };
      const schedules = { main: [2200, 10800, 16500, 19500], retail: [1700, 6300, 8000, 14000], away: [6800, 10800, 12700, 19700] };
      const ships = {} as Record<'main' | 'retail' | 'away', Point & { heading: number }>;
      for (const id of ['main','retail','away'] as const) {
        const [start, end, back, home] = schedules[id];
        const returning = time >= back;
        const p = returning ? 1 - ease((time - back) / (home - back)) : ease((time - start) / (end - start));
        const at = along(sea[id], p);
        if (returning) at.x += Math.sin(p * Math.PI) * w * .035;
        ships[id] = { ...at, heading: returning ? -1 : 1 };
      }
      const curve = (route: Route, colour: string, width = 1, dash = true) => {
        ctx.save(); ctx.strokeStyle = colour; ctx.lineWidth = width; ctx.lineCap = 'round'; ctx.setLineDash(dash ? [3,6] : []);
        if(colour===orange){ctx.lineWidth=2;ctx.shadowColor=orange+'45';ctx.shadowBlur=4;ctx.lineDashOffset=-time/650;}
        ctx.beginPath(); ctx.moveTo(route[0].x, route[0].y); ctx.quadraticCurveTo(route[1].x, route[1].y, route[2].x, route[2].y); ctx.stroke(); ctx.restore();
      };
      const straight = (a: Point, b: Point): Route => [a, mix(a,b,.5), b];
      const text = (words: string, p: Point, colour = labelInk, size = narrow ? 10.5 : 12) => {
        ctx.font = `600 ${size}px ${c.font}`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.strokeStyle = land; ctx.lineWidth = 3; ctx.strokeText(words,p.x,p.y); ctx.fillStyle = colour; ctx.fillText(words,p.x,p.y);
      };
      const pile = (p: Point, count: number, colour = teal, radius = r) => {
        for (let i = 0; i < count; i++) {
          const row = i < 4 ? 0 : i < 7 ? 1 : 2;
          const col = i < 4 ? i : i < 7 ? i - 4 : i - 7;
          ball(ctx,p.x + (col - (3 - row) / 2) * radius * 1.85,p.y - row * radius * 1.6,radius,colour);
        }
      };
      scenery(ctx,w,h,dark,time);
      // Small planted areas give the map a human scale without obscuring routes.
      for(const [x,y] of [[.065,.34],[.12,.62],[.91,.34],[.92,.49],[.78,.81]]) {
        const at=P(x,y); const size=narrow?4.5:6.5;
        art.tree(at.x-5,at.y+3,size); art.tree(at.x+5,at.y-2,size*1.15); art.tree(at.x+13,at.y+5,size*.8);
      }
      // A small fixed key; nothing here asks the reader to operate the diagram.
      ctx.font = `11px ${c.font}`; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
      for (const [x, colour, label] of [[22,orange,'Your route'],[125,teal,'Stock'],[198,grey,'Other orders']] as const) {
        ball(ctx,x,49,4,colour); ctx.fillStyle = c.muted; ctx.fillText(label,x+10,49);
      }
      const toCustomer: Route = [nodes.local,P(.94,.69),customer];
      const fromSouth: Route = [nodes.south,P(.64,.67),nodes.local];
      const fromCustoms: Route = [nodes.customs,P(.69,.59),nodes.local];
      const routes: Record<string,Route> = {
        'south-local': fromSouth, 'local-south': [nodes.local,P(.70,.81),nodes.south],
        'customs-local': fromCustoms,
        'factory-origin': [factory,P(.24,.30),nodes.origin],
        'factory-west': [factory,P(.07,.54),nodes.west],
      };
      for (const route of Object.values(routes)) curve(route,coast);
      for (const id of ['main','retail','away'] as const) curve(sea[id],seaLine);
      curve(straight(nodes.origin,sea.main[0]),coast);
      curve(straight(nodes.west,sea.retail[0]),coast);
      curve(straight(sea.retail[2],nodes.north),coast);
      curve(straight(sea.main[2],nodes.customs),coast);
      curve(toCustomer,orange,1.6);
      if (state.source === 'south') curve(fromSouth,orange,2);
      if (state.source === 'main' || state.source === 'customs') curve(fromCustoms,orange,1.6);
      if (state.source === 'main') curve([ships.main,sea.main[2],nodes.customs],orange,1.6);
      // A pool of warm light identifies the stock behind the estimate.
      let selected: Point = state.source==='main'?ships.main:nodes[state.source];
      if(state.source==='south') {
        const moving=state.moving.find(m=>m.kind==='transfer');
        if(moving) selected=along(fromSouth,ease((time-moving.at)/moving.duration));
      }
      const glow=ctx.createRadialGradient(selected.x,selected.y,3,selected.x,selected.y,42*scale);
      glow.addColorStop(0,orange+'35');glow.addColorStop(1,orange+'00');
      ctx.fillStyle=glow;ctx.fillRect(selected.x-44*scale,selected.y-44*scale,88*scale,88*scale);
      ctx.strokeStyle=orange;ctx.lineWidth=1;ctx.globalAlpha=.6;
      ctx.beginPath();ctx.ellipse(selected.x+3,selected.y+12,29*scale,10*scale,0,0,Math.PI*2);ctx.stroke();ctx.globalAlpha=1;
      ctx.save();ctx.beginPath();ctx.rect(0,70,w,h-70);ctx.clip();ctx.translate(factory.x,factory.y);ctx.scale(scale,scale);art.factory(time);ctx.restore();
      text('Factory',{x:factory.x,y:factory.y+28});
      const warehouse = (id: 'origin'|'west'|'north'|'local'|'south', name: string) => {
        const at=nodes[id];
        const arrivals=movements.filter(m=>m.to===id&&time>=m.at+m.duration);
        const sinceArrival=arrivals.length?Math.min(...arrivals.map(m=>time-m.at-m.duration)):Infinity;
        const bounce=sinceArrival<700?Math.sin(sinceArrival/70)*Math.exp(-sinceArrival/220):0;
        ctx.save(); ctx.translate(at.x,at.y); ctx.scale(scale,scale);
        const roof={origin:'#e8c57f',west:'#8cc8be',north:'#a8b5d8',local:'#eaa389',south:'#b1ca8b'}[id];
        art.warehouse(roof,bounce);ctx.restore();
        pile({x:at.x,y:at.y+5-Math.max(0,bounce)*3},state.stock[id],id==='north'?grey:teal);
        text(name,{x:at.x,y:at.y+28});
        const count=state.stock[id];
        text(id==='north'?`${count} reserved`:count?`${count} available`:'Empty',{x:at.x,y:at.y+43},id==='north'?(dark?grey:'#63718c'):count?(dark?teal:'#357e72'):c.muted,narrow?10:11);
      };
      warehouse('origin','Export A'); warehouse('west','Export B'); warehouse('north','North depot'); warehouse('local','Local depot'); warehouse('south','South depot');
      const port=nodes.customs;
      ctx.save();ctx.translate(port.x,port.y);ctx.scale(scale,scale);art.customs(ease((time-13300)/350));ctx.restore();
      pile({x:port.x-6,y:port.y+6},state.stock.customs);text('Customs',{x:port.x,y:port.y+29});
      // These ships have different destinations and allocations.
      for(const id of ['retail','away','main'] as const) {
        const ship=ships[id], colour=id==='main'?teal:grey;
        ctx.save();ctx.beginPath();ctx.rect(0,70,w,h-70);ctx.clip();ctx.translate(ship.x,ship.y+Math.sin(time/420+(id==='retail'?2:0))*2.4);ctx.rotate(Math.sin(time/620+(id==='away'?2:0))*.055);ctx.scale(ship.heading*scale,scale);
        art.ship(colour,time);
        pile({x:7,y:-3},state.stock[id],colour,r*.85/scale);ctx.restore();
      }
      const location = (id: Location): Point => id in ships ? ships[id as keyof typeof ships] : nodes[id as keyof typeof nodes];
      const movementRoute = (m: Movement): Route => {
        if(!m.from) return routes[`factory-${m.to}`];
        const from=location(m.from);
        if(!m.to) return [from,{x:from.x+40,y:from.y-12},{x:m.from==='away'?w*.53:w+15,y:from.y+8}];
        return routes[`${m.from}-${m.to}`] ?? [from,{x:(from.x+location(m.to).x)/2,y:Math.min(from.y,location(m.to).y)-18},location(m.to)];
      };
      for(const movement of state.moving) {
        const progress=clamp((time-movement.at)/movement.duration);
        const at=along(movementRoute(movement),ease(progress));
        const hop=Math.sin(progress*Math.PI)*7;
        art.shadow(at.x+1,at.y+5,r*.9,1.5);
        ball(ctx,at.x,at.y-hop,r,movement.kind==='transfer'?orange:movement.kind==='other'?grey:teal,1+Math.sin(progress*Math.PI*2)*.14);
      }
      // Other orders leave to the right, away from this customer's house.
      for(const id of ['north','local'] as const) curve([nodes[id],{x:w*.94,y:nodes[id].y-12},{x:w+10,y:nodes[id].y+8}],coast);
      ctx.save();ctx.translate(customer.x,customer.y);ctx.scale(scale,scale);art.home(time);ctx.restore();
      text('You',{x:customer.x,y:customer.y+29},dark?orange:'#a85a24');
      if(state.source!==lastSource) {
        lastSource=state.source;
        const words={
          local:['Arrives in 3–5 days','From the local depot.'],
          south:['Arrives in 6–8 days','Stock from the South depot, transferred via Local.'],
          main:['Arrives in about 2 weeks','The next available batch is on the incoming ship.'],
          customs:['Arrives in about 1 week','The incoming batch is clearing customs.'],
        }[state.source];
        estimate.textContent=words[0];sourceText.textContent=words[1];
      }
    };
    loop(figure,DURATION,5200,t=>{time=t;draw();});
  }
</script>
