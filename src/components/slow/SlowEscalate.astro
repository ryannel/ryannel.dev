---
import '../../styles/hitl.css';
import './loop.css';

/**
 * "Making the case" in notes/why-big-companies-are-slow: who gets to make the
 * priority call. New work arrives with a footprint, the teams it would touch.
 * The leads of those teams try first. If they can't agree, it goes to the
 * directors, who meet monthly and can align any number of teams. If they can't
 * agree either, it goes to senior leaders, who meet once a quarter and pick a
 * few. How far a call goes up depends on whether the group can settle it, not
 * on how many teams it touches.
 *
 * The delivery proposal (orange) touches every team and displaces committed
 * work everywhere, so it goes all the way up, waits through two quarterly
 * rounds, is picked at the third, and drops into every team's queue.
 *
 * Rates and timings are invented; it's a sketch of the shape.
 */
---

<figure class="hitl slow-loop slow-escalate" data-slow-escalate>
  <div class="hitl-stage">
    <canvas
      class="slow-canvas"
      role="img"
      aria-label="Four teams work through their own queues. New work arrives above the teams it touches. The leads of those teams settle most of it straight away. Some goes up to the directors, who meet monthly, and a little goes on to senior leaders, who meet quarterly. The orange delivery proposal touches all four teams. Neither the leads nor the directors can settle it, so it waits for senior leaders, loses two quarterly rounds and enters all four queues in Q3."
    ></canvas>
    <button class="loop-pause" data-pause-loop type="button" aria-label="Pause animation" aria-pressed="false">Ⅱ</button>
    <noscript><p class="hitl-note">New work goes to the lowest group that can agree on it: the team leads, the directors monthly, or senior leaders quarterly. The delivery proposal goes all the way up and waits until Q3 while the teams continue other work.</p></noscript>
  </div>
  <p class="hitl-readout"></p>
  <figcaption>
    New work arrives above the teams it touches and goes to the lowest group that can agree on
    it. Most calls stop with the team leads; some need the directors; a few need senior leaders.
    Each decision drops work into the affected queues and moves other jobs back. The next job is
    at the bottom. A sketch with invented timings and reporting lines.
  </figcaption>
</figure>

<style>
  .slow-escalate .hitl-stage {
    padding: 0;
    overflow: hidden;
  }
  .slow-canvas {
    display: block;
    width: 100%;
  }
</style>

<script>
  import { mulberry, theme, fit, label, NARROW } from './canvas';
  import { loop } from './loop';

  type Hue = [string, string]; // light, dark
  type Level = 0 | 1 | 2; // team leads, directors, senior leaders
  type Body = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    tx: number;
    ty: number;
    hue: Hue;
    span: number[]; // the teams it touches
    level: Level; // the group that can settle it
    due: number; // when the leads have talked it through
    ours: boolean;
    alpha: number;
    grow: number; // 0..1, scale-in when it appears
    flash: number; // 1..0, a ring when a decision is made
    pop: number; // < 0 alive; 0..1 popping (team work being done)
    acc: number;
    tone: number;
  };
  type Team = { hue: Hue; pace: number; work: number; balls: Body[] };
  type Note = { text: string; x: number; y: number; life: number; align: CanvasTextAlign; strong: boolean };

  const HUES: Hue[] = [
    ['#9a88d6', '#b1a2e6'],
    ['#5fa8a0', '#6fc2b8'],
    ['#d585ad', '#e6a0c2'],
    ['#8e9cb0', '#a9b5c6'],
  ];
  const PACES = [2300, 3400, 2600, 2900];
  const NAMES = ['Warehouse', 'Orders', 'Logistics', 'Website'];
  const OURS: Hue = ['#ec8a3c', '#f4a35e'];

  // The work that turns up, in order. Escalation follows whether the group can
  // agree, not the number of teams: leads settle some two-team work, directors
  // align three and four teams, and a three-team call can still go to the top.
  const ARRIVALS: { span: number[]; level: Level }[] = [
    { span: [1], level: 0 },
    { span: [0, 1], level: 0 },
    { span: [1, 2, 3], level: 1 },
    { span: [3], level: 0 },
    { span: [2, 3], level: 0 },
    { span: [0, 1, 2, 3], level: 1 },
    { span: [0], level: 0 },
    { span: [0, 2], level: 1 },
    { span: [2], level: 0 },
    { span: [0, 1, 3], level: 2 },
    { span: [1, 2], level: 0 },
  ];

  const K = 190; // spring stiffness, 1/s²
  const D = 13; // damping, 1/s
  const TICK = 16;
  const CAP = 6; // most balls in a team's queue
  const GAP = 1300; // ms between arrivals, on average, once the leads are free
  const TALK = 1000; // ms for the leads to talk something through
  const MONTH = 2200;
  const OURS_AT = 2400; // when the delivery proposal turns up
  const PERIOD = 3 * MONTH; // three monthly rounds per quarterly round
  const PICK = 900; // into a meeting, when the picks light up
  const OUT = 1500; // into a meeting, when it lets out
  const PICKS = 1;

  for (const figure of document.querySelectorAll<HTMLElement>('[data-slow-escalate]')) {
    const canvas = figure.querySelector<HTMLCanvasElement>('.slow-canvas')!;
    const readout = figure.querySelector<HTMLElement>('.hitl-readout')!;
    let narrow = false;

    const layout = (w: number) => {
      narrow = w < NARROW;
      const W = narrow ? 600 : 1000;
      return { W, H: (W / w) * 452 };
    };

    let draw = () => {};
    let drawnWidth = 0;
    let drawnPixel = 0;
    const c = theme(figure, () => draw());
    const { ctx, view, clear } = fit(canvas, layout, () => draw());
    const dark = () => {
      const m = c.paper.match(/\d+/g);
      return m ? Number(m[0]) + Number(m[1]) + Number(m[2]) < 300 : false;
    };

    const px = (n: number) => n * view.px;
    const R = () => px(narrow ? 8 : 9); // a proposal
    const r2 = () => px(7); // a piece of team work
    const gutter = () => px(narrow ? 92 : 168);
    const colW = () => (view.W - gutter() - px(8)) / HUES.length;
    const teamX = (i: number) => gutter() + colW() * (i + 0.5);
    const spanX = (span: number[]) => (teamX(Math.min(...span)) + teamX(Math.max(...span))) / 2;
    const geo = () => ({
      rows: [px(234), px(152), px(64)] as const, // leads, directors, senior leaders
      box: { x: gutter() - px(4), y: px(30), w: view.W - gutter() - px(4), h: px(68) },
      floor: px(392),
    });
    const teamSlot = (n: number) => geo().floor - r2() - n * (2 * r2() + px(3));

    let rand = mulberry(3);
    let t = 0;
    let pending = 0;
    let ours: Body | null = null;
    let rows: [Body[], Body[], Body[]] = [[], [], []];
    let room: Body[] = [];
    let picked: Body[] = [];
    let teams: Team[] = [];
    let notes: Note[] = [];
    let arrivals = 0;
    let arriveDue = 0;
    let nextMonth = MONTH;
    let directorRoundAt = -MONTH;
    let meeting = 0; // the current meeting's start, or 0
    let picksMade = false;
    let lastMeet = 0;
    let lost = 0; // meetings the delivery proposal has sat through
    let pickedAt = 0;
    let loopAt = 0;
    let changedPlansAt = 0;
    let displaced = new Map<Body, number>();
    let stage = 'start';

    const body = (hue: Hue, span: number[], x: number, y: number, isOurs = false, level: Level = 0): Body => ({
      x,
      y,
      vx: 0,
      vy: 0,
      tx: x,
      ty: y,
      hue,
      span,
      level,
      due: 0,
      ours: isOurs,
      alpha: 1,
      grow: 1,
      flash: 0,
      pop: -1,
      acc: 0,
      tone: rand() * 0.16 - 0.08,
    });

    const note = (text: string, x: number, y: number, align: CanvasTextAlign = 'left', strong = false, life = 1500) =>
      notes.push({ text, x, y, life, align, strong });

    const reset = () => {
      rand = mulberry(3);
      t = 0;
      pending = 0;
      ours = null;
      room = [];
      picked = [];
      notes = [];
      arrivals = 0;
      arriveDue = 400;
      nextMonth = MONTH;
      directorRoundAt = -MONTH;
      meeting = 0;
      lastMeet = 0;
      lost = 0;
      pickedAt = 0;
      loopAt = 0;
      changedPlansAt = 0;
      displaced = new Map();
      stage = 'start';
      const g = geo();
      // Two calls already wait for senior leaders.
      const waiting = [[0, 1, 2], [1, 2, 3]].map((span) => body(HUES[span[0]], span, spanX(span), g.rows[2], false, 2));
      rows = [[], [], waiting];
      teams = HUES.map((hue, i) => ({
        hue,
        pace: PACES[i],
        work: (i * 400) % PACES[i],
        balls: [0, 1, 2, 3].map((n) => body(hue, [i], teamX(i), teamSlot(n))),
      }));
    };

    /** New work turns up above the teams it touches, with their leads. */
    const arrive = (span: number[], level: Level, isOurs = false) => {
      const b = body(isOurs ? OURS : HUES[span[0]], span, spanX(span), geo().rows[0], isOurs, level);
      b.grow = 0.001;
      b.due = t + TALK + (isOurs ? 900 : 0);
      rows[0].push(b);
      return b;
    };

    /** A decision inserts work into every affected plan, ahead of lower priorities. */
    const settle = (b: Body) => {
      for (const i of b.span) {
        const tm = teams[i];
        const piece = body(b.hue, [i], b.x, b.y, b.ours);
        piece.flash = 1;
        const rank = Math.min(tm.balls.length, b.ours ? [1, 3, 2, 0][i] : 1);
        for (const later of tm.balls.slice(rank)) displaced.set(later, t + (b.ours ? 5200 : 1600));
        tm.balls.splice(rank, 0, piece);
      }
      b.alpha = 0;
    };

    const near = (b: Body) => Math.hypot(b.x - b.tx, b.y - b.ty) < px(4);

    /** Send a call up a level, with a short note where it was. */
    const raise = (b: Body, from: 0 | 1) => {
      rows[from] = rows[from].filter((x) => x !== b);
      rows[from + 1].push(b);
      b.ty = geo().rows[from + 1]; // so it isn't counted as arrived before it moves
      const x = b.x + R() + px(10);
      const y = b.y;
      if (b.ours) {
        note(from === 0 ? 'the leads can’t agree' : 'the directors can’t agree', x, y, 'left', true, 1800);
        stage = from === 0 ? 'directors' : 'senior';
      } else note(from === 0 ? 'up to directors' : 'up to senior leaders', x, y);
    };

    /** One fixed step: decisions, meetings, the teams' work, and every spring. */
    const step = () => {
      t += TICK;
      const g = geo();

      // New work turns up whenever the leads are free.
      if (!pickedAt && rows[0].length === 0) {
        arriveDue -= TICK;
        if (arriveDue <= 0) {
          arriveDue = GAP * (0.6 + 0.8 * rand());
          if (!ours && t >= OURS_AT) {
            ours = arrive([0, 1, 2, 3], 2, true);
            stage = 'arrived';
          } else {
            const a = ARRIVALS[arrivals++ % ARRIVALS.length];
            arrive(a.span, a.level);
          }
        }
      }

      // The leads of the affected teams talk it through.
      for (const b of rows[0]) {
        if (t < b.due || !near(b)) continue;
        if (b.level === 0) {
          rows[0] = rows[0].filter((x) => x !== b);
          settle(b);
        } else raise(b, 0);
      }

      // Directors meet monthly and can align any number of teams.
      if (t >= nextMonth && !pickedAt) {
        nextMonth += MONTH;
        directorRoundAt = t;
        for (const b of rows[1].filter(near)) {
          if (b.level === 1) {
            rows[1] = rows[1].filter((x) => x !== b);
            settle(b);
          } else raise(b, 1);
        }
      }

      // Senior leaders meet once a quarter and pick a few.
      if (!meeting && !pickedAt && t - lastMeet >= PERIOD) {
        meeting = t;
        picksMade = false;
        room = rows[2].filter(near);
      }
      if (meeting && !picksMade && t - meeting >= PICK) {
        picksMade = true;
        const others = room.filter((b) => !b.ours);
        const ourTurn = !!ours && room.includes(ours) && lost >= 2;
        picked = ourTurn ? [ours!, ...others.slice(0, PICKS - 1)] : others.slice(0, PICKS);
        for (const b of picked) b.flash = 1;
        if (ours && room.includes(ours) && !ourTurn) {
          lost++;
          stage = 'lost';
          note(`Q${lost}: other work picked`, g.box.x + g.box.w / 2, g.box.y + g.box.h + px(14), 'center', true, 1800);
        }
        if (ourTurn) {
          pickedAt = t;
          stage = 'picked';
        }
      }
      if (meeting && t - meeting >= OUT) {
        rows[2] = rows[2].filter((b) => !picked.includes(b));
        for (const b of picked) settle(b);
        if (picked.some((b) => b.ours)) {
          changedPlansAt = t;
          stage = 'done';
          loopAt = t + 5600;
        }
        room = [];
        picked = [];
        lastMeet = meeting;
        meeting = 0;
      }

      // Where everything is headed. Calls sit over the teams they touch,
      // nudged apart when two share a row.
      rows.forEach((list, level) => {
        const sorted = [...list].sort((a, b) => spanX(a.span) - spanX(b.span));
        let prev = -Infinity;
        const gap = px(26);
        for (const b of sorted) {
          b.tx = Math.max(spanX(b.span), prev + gap);
          b.ty = g.rows[level];
          prev = b.tx;
        }
        const over = prev - (view.W - px(16));
        if (over > 0) for (const b of sorted) b.tx -= over;
      });
      // Senior leaders weigh everything together: one row across the room.
      rows[2].forEach((b, i) => {
        b.tx = g.box.x + g.box.w / 2 + (i - (rows[2].length - 1) / 2) * px(26);
      });
      teams.forEach((tm, i) =>
        tm.balls.forEach((b, n) => {
          b.tx = teamX(i);
          b.ty = teamSlot(n);
        }),
      );

      // The teams keep working through it all.
      teams.forEach((tm) => {
        // Hold the rearrangement briefly so the displaced work is visible.
        if (changedPlansAt && t - changedPlansAt < 1600) return;
        const bottom = tm.balls[0];
        if (!bottom) return;
        if (bottom.pop >= 0) {
          bottom.pop += TICK / 320;
          if (bottom.pop >= 1) tm.balls.shift();
          return;
        }
        tm.work += TICK;
        if (tm.work >= tm.pace) {
          tm.work = 0;
          bottom.pop = 0;
        }
      });
      // There is already more planned work than fits in the visible list.
      // Refill from that backlog while the proposal is being considered.
      if (!pickedAt)
        teams.forEach((tm, i) => {
          if (tm.balls.length < 4) {
            const b = body(tm.hue, [i], teamX(i), teamSlot(5));
            b.grow = 0.001;
            tm.balls.push(b);
          }
        });
      for (const tm of teams) if (tm.balls.length > CAP + 2) tm.balls.length = CAP + 2;
      const queued = new Set(teams.flatMap((tm) => tm.balls));
      for (const [b, until] of displaced) if (!queued.has(b) || t >= until) displaced.delete(b);

      const all = new Set([...rows.flat(), ...teams.flatMap((tm) => tm.balls)]);
      const h = TICK / 2 / 1000;
      for (const b of all) {
        for (let s = 0; s < 2; s++) {
          const ax = K * (b.tx - b.x) - D * b.vx;
          const ay = K * (b.ty - b.y) - D * b.vy;
          b.vx += ax * h;
          b.vy += ay * h;
          b.x += b.vx * h;
          b.y += b.vy * h;
          b.acc = ay;
        }
        if (b.grow > 0 && b.grow < 1) b.grow = Math.min(1, b.grow + TICK / 300);
        if (b.flash > 0 && !picked.includes(b)) b.flash = Math.max(0, b.flash - TICK / 700);
      }
      for (const n of notes) n.life -= TICK;
      notes = notes.filter((n) => n.life > 0);
      if (loopAt && t >= loopAt) reset();
    };

    const describe = () => {
      readout.textContent = {
        start: 'New work arrives above the teams it touches. If their leads can agree, it goes straight into their plans.',
        arrived: 'Delivery dates touch all four teams. Their leads meet, but each would have to drop committed work.',
        directors: 'The directors meet monthly and can align any number of teams. This one cuts into all of their goals.',
        senior: 'Only senior leaders can weigh it against everything else. They meet quarterly.',
        lost: `Q${lost}: other work wins. Below them, leads and directors keep settling smaller calls.`,
        picked: 'Chosen in Q3: the leaders make room for the delivery work in every team’s plan.',
        done: 'Delivery work moves into all four plans. The outlined jobs move back to make room; work ahead of it still comes first.',
      }[stage]!;
    };

    const shade = (hex: string, amt: number) => {
      const n = parseInt(hex.slice(1), 16);
      const f = (v: number) => Math.max(0, Math.min(255, Math.round(v + amt * 255)));
      return `rgb(${f(n >> 16)}, ${f((n >> 8) & 255)}, ${f(n & 255)})`;
    };

    const drawBody = (b: Body, rr: number, dk: number) => {
      if (b.grow <= 0 || b.alpha <= 0) return;
      const base = b.hue[dk];
      const s = Math.max(0.8, Math.min(1.16, 1 + b.acc / 260000));
      let scale = b.grow < 1 ? 1 - Math.pow(1 - b.grow, 3) + Math.sin(b.grow * Math.PI) * 0.15 : 1;
      let alpha = b.alpha;
      if (b.pop >= 0) {
        scale *= 1 + 0.35 * Math.sin(Math.min(1, b.pop) * Math.PI * 0.5);
        alpha *= 1 - Math.min(1, b.pop);
      }
      const w = (rr * scale) / Math.sqrt(s);
      const hh = rr * scale * s;
      ctx.save();
      ctx.globalAlpha = alpha;
      const g = ctx.createRadialGradient(b.x - w * 0.35, b.y - hh * 0.4, rr * 0.1, b.x, b.y, rr * 1.1);
      g.addColorStop(0, shade(base, 0.22 + b.tone));
      g.addColorStop(1, shade(base, -0.06 + b.tone));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(b.x, b.y, w, hh, 0, 0, Math.PI * 2);
      ctx.fill();
      if (b.ours) {
        ctx.lineWidth = px(2);
        ctx.strokeStyle = shade(base, -0.18);
        ctx.stroke();
      }
      if (displaced.has(b)) {
        ctx.strokeStyle = c.muted;
        ctx.lineWidth = px(1);
        ctx.setLineDash([px(2), px(3)]);
        ctx.beginPath();
        ctx.ellipse(b.x, b.y, w + px(4), hh + px(4), 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.setLineDash([]);
      }
      if (b.flash > 0) {
        ctx.globalAlpha = alpha * Math.min(1, b.flash * 1.5);
        ctx.lineWidth = px(2);
        ctx.strokeStyle = b.ours ? OURS[dk] : c.accent;
        ctx.beginPath();
        ctx.arc(b.x, b.y, rr + px(4) + (1 - b.flash) * px(6), 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.restore();
    };

    /** The footprint: a bracket under a call, with a dot over each team it touches. */
    const footprint = (b: Body, dk: number) => {
      const scale = b.grow < 1 ? b.grow : 1;
      const y = b.y + R() + px(9);
      const reach = colW() * 0.34;
      const x0 = teamX(Math.min(...b.span)) - reach;
      const x1 = teamX(Math.max(...b.span)) + reach;
      ctx.save();
      ctx.globalAlpha = 0.75 * scale;
      ctx.strokeStyle = b.hue[dk];
      ctx.fillStyle = b.hue[dk];
      ctx.lineWidth = px(1.5);
      ctx.beginPath();
      ctx.moveTo(x0, y - px(4));
      ctx.lineTo(x0, y);
      ctx.lineTo(x1, y);
      ctx.lineTo(x1, y - px(4));
      ctx.stroke();
      for (const i of b.span) {
        ctx.beginPath();
        ctx.arc(teamX(i), y, px(3), 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    };

    /** A clock that fills towards the next meeting. */
    const dial = (x: number, y: number, f: number, on: boolean) => {
      const dr = px(8);
      ctx.strokeStyle = c.rule;
      ctx.lineWidth = px(1.25);
      ctx.beginPath();
      ctx.arc(x, y, dr, 0, Math.PI * 2);
      ctx.stroke();
      if (f <= 0) return;
      ctx.save();
      ctx.fillStyle = c.accent;
      ctx.globalAlpha = on ? 0.9 : 0.5;
      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.arc(x, y, dr - px(1.5), -Math.PI / 2, -Math.PI / 2 + f * Math.PI * 2);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
    };

    draw = () => {
      // The simulation stores drawing coordinates. Reproject them when the
      // canvas changes size, including while the reader has paused it.
      if (drawnWidth && (drawnWidth !== view.W || drawnPixel !== view.px)) {
        const sx = view.W / drawnWidth;
        const sy = view.px / drawnPixel;
        for (const b of new Set([...rows.flat(), ...teams.flatMap((tm) => tm.balls)])) {
          b.x *= sx; b.tx *= sx; b.vx *= sx;
          b.y *= sy; b.ty *= sy; b.vy *= sy;
        }
        for (const n of notes) { n.x *= sx; n.y *= sy; }
      }
      drawnWidth = view.W;
      drawnPixel = view.px;
      clear(c.paper);
      const dk = dark() ? 1 : 0;
      const g = geo();
      ctx.textBaseline = 'middle';

      // Senior leaders: a room over every team, lit while they meet.
      const open = meeting ? Math.max(0, Math.min(1, (t - meeting) / 250, (meeting + OUT - t) / 250)) : 0;
      ctx.save();
      ctx.beginPath();
      ctx.roundRect(g.box.x, g.box.y, g.box.w, g.box.h, px(10));
      ctx.globalAlpha = 0.12 * open;
      ctx.fillStyle = c.accent;
      ctx.fill();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = open > 0 ? c.accent : c.rule;
      ctx.lineWidth = px(1.5);
      ctx.stroke();
      ctx.restore();

      // Directors light up for each monthly round.
      const round = Math.max(0, 1 - (t - directorRoundAt) / 700);

      // Who decides, in the gutter.
      const lx = px(narrow ? 6 : 16);
      const who: [string, string, number | null, boolean][] = [
        ['Team leads', 'as it comes up', null, false],
        ['Directors', 'monthly', (t % MONTH) / MONTH, round > 0],
        ['Senior leaders', 'quarterly', meeting ? 1 : Math.min(1, Math.max(0, (t - lastMeet) / PERIOD)), open > 0],
      ];
      who.forEach(([name, when, f, on], level) => {
        const y = g.rows[level];
        ctx.font = `600 ${px(narrow ? 11 : 13)}px ${c.font}`;
        label(ctx, c, view.px, name, lx, y - px(8), on ? c.accent : c.ink, 'left');
        ctx.font = `500 ${px(narrow ? 10 : 12)}px ${c.font}`;
        label(ctx, c, view.px, when, lx + (f === null || narrow ? 0 : px(22)), y + px(10), c.muted, 'left');
        if (f !== null && !narrow) dial(lx + px(8), y + px(10), f, on);
      });

      // The teams and their queues of work.
      teams.forEach((tm, i) => {
        const x = teamX(i);
        ctx.strokeStyle = c.rule;
        ctx.lineWidth = px(1.5);
        ctx.beginPath();
        ctx.moveTo(x - px(narrow ? 20 : 34), g.floor);
        ctx.lineTo(x + px(narrow ? 20 : 34), g.floor);
        ctx.stroke();
        const bottom = tm.balls[0];
        if (bottom && bottom.pop < 0 && !(changedPlansAt && t - changedPlansAt < 1600)) {
          ctx.strokeStyle = tm.hue[dk];
          ctx.lineWidth = px(2);
          ctx.beginPath();
          ctx.arc(bottom.x, bottom.y, r2() + px(4), -Math.PI / 2, -Math.PI / 2 + (tm.work / tm.pace) * Math.PI * 2);
          ctx.stroke();
        }
        for (const b of tm.balls) drawBody(b, r2(), dk);
        ctx.font = `500 ${px(narrow ? 11 : 13)}px ${c.font}`;
        label(ctx, c, view.px, NAMES[i], x, g.floor + px(16), c.muted);
      });
      ctx.font = `${px(11)}px ${c.font}`;
      label(ctx, c, view.px, 'Next job at the bottom · outlined jobs move back', g.box.x + g.box.w / 2, g.floor + px(40), c.muted);

      // Calls waiting on a decision, with the teams each one touches. In the
      // senior leaders' room every call is weighed across all of it.
      const waiting = [...rows[0], ...rows[1], ...rows[2]];
      for (const b of [...rows[0], ...rows[1]]) if (b.alpha > 0) footprint(b, dk);
      for (const b of waiting) if (!b.ours) drawBody(b, R(), dk);
      if (ours && ours.alpha > 0) {
        drawBody(ours, R(), dk);
        if (stage !== 'done') {
          ctx.font = `600 ${px(12)}px ${c.font}`;
          ctx.save();
          ctx.globalAlpha = ours.grow < 1 ? ours.grow : 1;
          label(ctx, c, view.px, 'Delivery dates', ours.x, ours.y - R() - px(11), OURS[dk]);
          ctx.restore();
        }
      }

      for (const n of notes) {
        ctx.save();
        ctx.font = `${n.strong ? 600 : 500} ${px(12)}px ${c.font}`;
        ctx.globalAlpha = Math.max(0, Math.min(1, n.life / 300, (1800 - n.life) / 150));
        const w = ctx.measureText(n.text).width;
        const nx = n.align === 'left' ? Math.min(n.x, view.W - w - px(8)) : n.x;
        label(ctx, c, view.px, n.text, nx, n.y, n.strong ? c.ink : c.muted, n.align);
        ctx.restore();
      }
    };

    reset();
    // Use the shared offscreen, pause and reduced-motion behaviour. The simulation
    // keeps its own cycle; this clock only supplies elapsed time to its fixed steps.
    const CLOCK = 60000;
    const SPEED = 0.8; // A full cycle takes about 34 seconds.
    let previous = 0;
    let wasStill = false;
    loop(figure, CLOCK, 7000, (clock) => {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) {
        reset();
        pending = 7000 * 1.6;
      } else if (!wasStill) {
        pending += ((clock - previous + CLOCK) % CLOCK) * SPEED;
      }
      wasStill = still;
      previous = clock;
      while (pending >= TICK) {
        pending -= TICK;
        step();
      }
      describe();
      draw();
    });
  }
</script>
