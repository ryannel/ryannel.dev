---
import '../../styles/hitl.css';
import './loop.css';

/**
 * "Making the case" in notes/why-big-companies-are-slow: how decisions bubble
 * up. Proposals rise from the teams to their team leads, who settle most of
 * them and change one team's plan. Directors meet monthly and coordinate
 * pairs of teams; decisions spanning both pairs go to a
 * bench outside leadership, which meets once a quarter and picks a few. The
 * delivery proposal (orange) touches every team, so it goes all the way up,
 * waits through two meetings, is picked at the third, and drops back down into
 * every team's queue. Then it starts again.
 *
 * Rates and timings are invented; it's a sketch of the shape.
 */
---

<figure class="hitl slow-loop slow-escalate" data-slow-escalate>
  <div class="hitl-stage">
    <canvas
      class="slow-canvas"
      role="img"
      aria-label="Four teams keep working through their own priorities. Each team lead changes one team's list. Two directors meet monthly, each coordinating a pair of teams. Senior leaders meet quarterly and change all four lists. Decisions send matching balls into the affected queues, pushing other work back. The orange delivery proposal waits through Q1 and Q2, then enters all four plans in Q3."
    ></canvas>
    <button class="loop-pause" data-pause-loop type="button" aria-label="Pause animation" aria-pressed="false">Ⅱ</button>
    <noscript><p class="hitl-note">Team leads reprioritise one team, directors coordinate two teams monthly, and senior leaders coordinate all four quarterly. The delivery proposal waits until Q3 while the teams continue other work.</p></noscript>
  </div>
  <p class="hitl-readout"></p>
  <figcaption>
    Team leads change one list. Directors coordinate two teams in monthly rounds; senior
    leaders coordinate all four quarterly. Each decision sends matching balls into the affected
    lists, moving other jobs back. The orange delivery proposal waits until Q3. The next job is
    at the bottom. A sketch with invented timings and reporting lines.
  </figcaption>
</figure>

<style>
  .slow-escalate .hitl-stage {
    padding: 0;
    overflow: hidden;
  }
  .slow-canvas {
    display: block;
    width: 100%;
  }
</style>

<script>
  import { mulberry, theme, fit, label, NARROW } from './canvas';
  import { loop } from './loop';

  type Hue = [string, string]; // light, dark
  type Body = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    tx: number;
    ty: number;
    hue: Hue;
    team: number;
    scope: 1 | 2 | 4;
    ours: boolean;
    alpha: number;
    grow: number; // 0..1, scale-in when it appears
    flash: number; // 1..0, a ring when a decision is made
    pop: number; // < 0 alive; 0..1 popping (team work being done)
    acc: number;
    tone: number;
  };
  type Team = { hue: Hue; pace: number; work: number; balls: Body[] };

  const HUES: Hue[] = [
    ['#9a88d6', '#b1a2e6'],
    ['#5fa8a0', '#6fc2b8'],
    ['#d585ad', '#e6a0c2'],
    ['#8e9cb0', '#a9b5c6'],
  ];
  const PACES = [2300, 3400, 2600, 2900];
  const NAMES = ['Warehouse', 'Orders', 'Logistics', 'Website'];
  const OURS: Hue = ['#ec8a3c', '#f4a35e'];

  const K = 190; // spring stiffness, 1/s²
  const D = 13; // damping, 1/s
  const TICK = 16;
  const CAP = 6; // most balls in a team's queue
  const SPAWN = 1700; // ms between new proposals, on average
  const LEADS = 620; // ms per decision at team leads
  const MONTH = 2200;
  const OURS_AT = 2400; // when the delivery proposal sets off
  const PERIOD = 3 * MONTH; // three monthly rounds per quarterly round
  const PICK = 900; // into a meeting, when the picks light up
  const OUT = 1500; // into a meeting, when it lets out
  const PICKS = 1;

  for (const figure of document.querySelectorAll<HTMLElement>('[data-slow-escalate]')) {
    const canvas = figure.querySelector<HTMLCanvasElement>('.slow-canvas')!;
    const readout = figure.querySelector<HTMLElement>('.hitl-readout')!;
    let narrow = false;

    const layout = (w: number) => {
      narrow = w < NARROW;
      const W = narrow ? 600 : 1000;
      return { W, H: (W / w) * 510 };
    };

    let draw = () => {};
    let drawnWidth = 0;
    let drawnPixel = 0;
    const c = theme(figure, () => draw());
    const { ctx, view, clear } = fit(canvas, layout, () => draw());
    const dark = () => {
      const m = c.paper.match(/\d+/g);
      return m ? Number(m[0]) + Number(m[1]) + Number(m[2]) < 300 : false;
    };

    const px = (n: number) => n * view.px;
    const R = () => px(narrow ? 8 : 9); // a proposal
    const r2 = () => px(7); // a piece of team work
    const geo = () => {
      const cx = view.W / 2;
      const boxW = px(narrow ? 250 : 300);
      return {
        cx,
        box: { x: cx - boxW / 2, y: px(28), w: boxW, h: px(58) },
        benchY: px(130),
        directorsY: px(198),
        leadsY: px(266),
        floor: px(402),
        stripY: px(474),
      };
    };
    const teamX = (i: number) => (view.W / HUES.length) * (i + 0.5);
    const directorX = (i: number) => view.W * (Math.floor(i / 2) * 0.5 + 0.25);
    const leadWidth = () => view.W / 4 * 0.65;
    const directorWidth = () => Math.min(view.W * 0.36, px(230));
    const teamSlot = (n: number) => geo().floor - r2() - n * (2 * r2() + px(3));

    let rand = mulberry(3);
    let t = 0;
    let pending = 0;
    let ours: Body | null = null;
    let leads: Body[] = [];
    let directors: Body[] = [];
    let bench: Body[] = [];
    let room: Body[] = [];
    let picked: Body[] = [];
    let moving: Body[] = []; // the chosen delivery proposal, before it splits
    let teams: Team[] = [];
    let notes: { text: string; x: number; y: number; life: number }[] = [];
    let decisions: { x: number; y: number; pieces: Body[]; at: number; hue: Hue }[] = [];
    let proposalCount = 0;
    let spawnDue = 0;
    let leadsDue = [0, 0, 0, 0];
    let nextMonth = MONTH;
    let directorRoundAt = -MONTH;
    let meeting = 0; // the current meeting's start, or 0
    let picksMade = false;
    let lastMeet = 0;
    let lost = 0; // meetings the delivery proposal has sat through
    let pickedAt = 0;
    let splitAt = 0;
    let loopAt = 0;
    let changedPlansAt = 0;
    let displaced = new Map<Body, number>();
    let stage = 'start';

    const body = (hue: Hue, team: number, x: number, y: number, isOurs = false, scope: 1 | 2 | 4 = 1): Body => ({
      x,
      y,
      vx: 0,
      vy: 0,
      tx: x,
      ty: y,
      hue,
      team,
      scope,
      ours: isOurs,
      alpha: 1,
      grow: 1,
      flash: 0,
      pop: -1,
      acc: 0,
      tone: rand() * 0.16 - 0.08,
    });

    const reset = () => {
      rand = mulberry(3);
      t = 0;
      pending = 0;
      ours = null;
      leads = [];
      directors = [];
      room = [];
      picked = [];
      moving = [];
      notes = [];
      decisions = [];
      proposalCount = 0;
      spawnDue = 200;
      leadsDue = [LEADS, LEADS, LEADS, LEADS];
      nextMonth = MONTH;
      directorRoundAt = -MONTH;
      meeting = 0;
      lastMeet = 0;
      lost = 0;
      pickedAt = 0;
      splitAt = 0;
      loopAt = 0;
      changedPlansAt = 0;
      displaced = new Map();
      stage = 'start';
      const g = geo();
      bench = [1, 2].map((h, k) => body(HUES[h], h, g.cx + (k - 0.5) * px(24), g.benchY - R(), false, 4));
      directors = [0, 2].map(h => body(HUES[h], h, directorX(h), g.directorsY - R(), false, 2));
      teams = HUES.map((hue, i) => ({
        hue,
        pace: PACES[i],
        work: (i * 400) % PACES[i],
        balls: [0, 1, 2, 3].map((n) => body(hue, i, teamX(i), teamSlot(n))),
      }));
    };

    /** A new proposal rises from team i towards the team leads. */
    const propose = (i: number, isOurs = false) => {
      const scopes = [1, 2, 1, 2, 1, 4] as const;
      const scope = isOurs ? 4 : scopes[proposalCount++ % scopes.length];
      const b = body(isOurs ? OURS : HUES[i], i, teamX(i), teamSlot(teams[i].balls.length) - px(4), isOurs, scope);
      b.grow = 0.001;
      leads.push(b);
      return b;
    };

    /** A decision inserts work into every affected plan, ahead of lower priorities. */
    const settle = (b: Body) => {
      const pair = Math.floor(b.team / 2) * 2;
      const affected = b.scope === 4 ? [0, 1, 2, 3] : b.scope === 2 ? [pair, pair + 1] : [b.team];
      const pieces = affected.map(i => {
        const tm = teams[i];
        const piece = body(b.hue, i, b.x, b.y, b.ours);
        piece.flash = 1;
        const rank = Math.min(tm.balls.length, b.ours ? [1, 3, 2, 0][i] : 1);
        for (const later of tm.balls.slice(rank)) displaced.set(later, t + (b.ours ? 5200 : 1600));
        tm.balls.splice(rank, 0, piece);
        return piece;
      });
      decisions.push({ x: b.x, y: b.y, pieces, at: t, hue: b.hue });
      b.alpha = 0;
    };

    const bump = (b: Body, y: number) => {
      b.vx += px(260);
      notes.push({ text: 'needs all four teams', x: geo().cx - px(56), y: y + px(20), life: 1300 });
    };

    /** One fixed step: decisions, meetings, the teams' work, and every spring. */
    const step = () => {
      t += TICK;
      const g = geo();

      // New proposals keep coming up from the teams.
      spawnDue -= TICK;
      if (spawnDue <= 0 && !pickedAt) {
        spawnDue = SPAWN * (0.5 + rand());
        if (leads.length < 9) propose(Math.floor(rand() * HUES.length));
      }
      if (!ours && t >= OURS_AT) {
        ours = propose(HUES.length - 1, true);
        stage = 'rising';
      }

      // Team leads settle what they can and pass the rest up.
      teams.forEach((_, i) => {
        leadsDue[i] -= TICK;
        const atLeads = leads.find(b => b.team === i);
        if (leadsDue[i] <= 0 && atLeads && Math.hypot(atLeads.x - atLeads.tx, atLeads.y - atLeads.ty) < px(4)) {
          leadsDue[i] = LEADS;
          leads = leads.filter(b => b !== atLeads);
          if (atLeads.scope === 1) settle(atLeads);
          else {
            if (atLeads.ours) {
              bump(atLeads, g.leadsY - R());
              stage = 'directors';
            }
            directors.push(atLeads);
          }
        }
      });
      // Each director can change both teams' plans in the monthly round.
      if (t >= nextMonth && !pickedAt) {
        nextMonth += MONTH;
        directorRoundAt = t;
        for (const pair of [0, 1]) {
          const proposal = directors.find(b => Math.floor(b.team / 2) === pair);
          if (!proposal || Math.hypot(proposal.x - proposal.tx, proposal.y - proposal.ty) >= px(4)) continue;
          directors = directors.filter(b => b !== proposal);
          if (proposal.scope === 2) settle(proposal);
          else {
            if (proposal.ours) {
              bump(proposal, g.directorsY - R());
              stage = 'bench';
            }
            bench.push(proposal);
          }
        }
      }

      // Leadership meets once a quarter.
      if (!meeting && !pickedAt && t - lastMeet >= PERIOD) {
        meeting = t;
        picksMade = false;
        room = bench;
        bench = [];
      }
      if (meeting && !picksMade && t - meeting >= PICK) {
        picksMade = true;
        const others = room.filter((b) => !b.ours);
        const ourTurn = !!ours && room.includes(ours) && lost >= 2;
        picked = ourTurn ? [ours!, ...others.slice(0, PICKS - 1)] : others.slice(0, PICKS);
        for (const b of picked) b.flash = 1;
        if (ours && room.includes(ours) && !ourTurn) {
          lost++;
          stage = 'lost';
          notes.push({ text: 'not picked this time', x: g.box.x + g.box.w + px(10), y: g.box.y + g.box.h - px(10), life: 1300 });
        }
        if (ourTurn) {
          pickedAt = t;
          stage = 'picked';
        }
      }
      if (meeting && t - meeting >= OUT) {
        bench = room.filter((b) => !picked.includes(b));
        for (const b of picked) {
          if (b.ours) {
            moving.push(b);
            b.tx = g.cx;
            b.ty = teamSlot(CAP) - px(20);
            splitAt = t + 900;
          } else settle(b);
        }
        room = [];
        picked = [];
        lastMeet = meeting;
        meeting = 0;
      }
      // The delivery work splits into every team's queue.
      if (splitAt && t >= splitAt && ours && ours.alpha > 0) {
        moving = moving.filter((b) => b !== ours);
        settle(ours);
        changedPlansAt = t;
        stage = 'done';
        loopAt = t + 5200;
      }

      // Where everything is headed.
      const row = (list: Body[], y: number, x0?: number) =>
        list.forEach((b, i) => {
          b.tx = x0 === undefined ? g.cx + (i - (list.length - 1) / 2) * px(22) : x0 + px(14) + i * px(22);
          b.ty = y;
        });
      for (let i = 0; i < 4; i++) {
        const list = leads.filter(b => b.team === i);
        list.forEach((b, j) => { b.tx = teamX(i) + (j - (list.length - 1) / 2) * px(18); b.ty = g.leadsY - R(); });
      }
      for (let i = 0; i < 2; i++) {
        const list = directors.filter(b => Math.floor(b.team / 2) === i);
        list.forEach((b, j) => { b.tx = directorX(i * 2) + (j - (list.length - 1) / 2) * px(20); b.ty = g.directorsY - R(); });
      }
      row(bench, g.benchY - R());
      row(room, g.box.y + g.box.h / 2 + px(8));
      teams.forEach((tm, i) =>
        tm.balls.forEach((b, n) => {
          b.tx = teamX(i);
          b.ty = teamSlot(n);
        }),
      );

      // The teams keep working through it all.
      teams.forEach((tm) => {
        // Hold the rearrangement briefly so the displaced work is visible.
        if (changedPlansAt && t - changedPlansAt < 1600) return;
        const bottom = tm.balls[0];
        if (!bottom) return;
        if (bottom.pop >= 0) {
          bottom.pop += TICK / 320;
          if (bottom.pop >= 1) tm.balls.shift();
          return;
        }
        tm.work += TICK;
        if (tm.work >= tm.pace) {
          tm.work = 0;
          bottom.pop = 0;
        }
      });
      // There is already more planned work than fits in the visible list.
      // Refill from that backlog while the proposal is being considered.
      if (!pickedAt) teams.forEach((tm, i) => {
        if (tm.balls.length < 4) {
          const b = body(tm.hue, i, teamX(i), teamSlot(5));
          b.grow = 0.001;
          tm.balls.push(b);
        }
      });
      decisions = decisions.filter(d => t - d.at < 1500);
      const queued = new Set(teams.flatMap(tm => tm.balls));
      for (const [b, until] of displaced) if (!queued.has(b) || t >= until) displaced.delete(b);

      const all = new Set([...leads, ...directors, ...bench, ...room, ...moving, ...teams.flatMap((tm) => tm.balls)]);
      if (ours) all.add(ours);
      const h = TICK / 2 / 1000;
      for (const b of all) {
        for (let s = 0; s < 2; s++) {
          const ax = K * (b.tx - b.x) - D * b.vx;
          const ay = K * (b.ty - b.y) - D * b.vy;
          b.vx += ax * h;
          b.vy += ay * h;
          b.x += b.vx * h;
          b.y += b.vy * h;
          b.acc = ay;
        }
        if (b.grow > 0 && b.grow < 1) b.grow = Math.min(1, b.grow + TICK / 300);
        if (b.flash > 0 && !picked.includes(b)) b.flash = Math.max(0, b.flash - TICK / 700);
      }
      for (const n of notes) n.life -= TICK;
      notes = notes.filter((n) => n.life > 0);
      if (loopAt && t >= loopAt) reset();
    };

    const describe = () => {
      readout.textContent = {
        start: 'Team leads change one team’s priorities. Monthly director decisions coordinate a pair of teams.',
        rising: 'Delivery dates need work from all four teams. Each already has other priorities.',
        directors: 'A director can coordinate two teams. Delivery dates need all four, so this decision goes higher.',
        bench: 'Senior leaders can weigh all four teams’ priorities together. The proposal waits for their quarterly round.',
        lost: `Q${lost}: other work takes priority across all four teams. Team leads and directors keep making smaller decisions.`,
        picked: 'Chosen: the leaders make room for the delivery work across the teams’ plans.',
        done: 'Delivery work moves into all four plans. The outlined jobs move back to make room; work ahead of it still comes first.',
      }[stage]!;
    };

    const shade = (hex: string, amt: number) => {
      const n = parseInt(hex.slice(1), 16);
      const f = (v: number) => Math.max(0, Math.min(255, Math.round(v + amt * 255)));
      return `rgb(${f(n >> 16)}, ${f((n >> 8) & 255)}, ${f(n & 255)})`;
    };

    const drawBody = (b: Body, rr: number, dk: number) => {
      if (b.grow <= 0 || b.alpha <= 0) return;
      const base = b.hue[dk];
      const s = Math.max(0.8, Math.min(1.16, 1 + b.acc / 260000));
      let scale = b.grow < 1 ? 1 - Math.pow(1 - b.grow, 3) + Math.sin(b.grow * Math.PI) * 0.15 : 1;
      let alpha = b.alpha;
      if (b.pop >= 0) {
        scale *= 1 + 0.35 * Math.sin(Math.min(1, b.pop) * Math.PI * 0.5);
        alpha *= 1 - Math.min(1, b.pop);
      }
      const w = (rr * scale) / Math.sqrt(s);
      const hh = rr * scale * s;
      const tone = b.tone === -1 ? 0 : b.tone;
      ctx.save();
      ctx.globalAlpha = alpha;
      const g = ctx.createRadialGradient(b.x - w * 0.35, b.y - hh * 0.4, rr * 0.1, b.x, b.y, rr * 1.1);
      g.addColorStop(0, shade(base, 0.22 + tone));
      g.addColorStop(1, shade(base, -0.06 + tone));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(b.x, b.y, w, hh, 0, 0, Math.PI * 2);
      ctx.fill();
      if (b.ours) {
        ctx.lineWidth = px(2);
        ctx.strokeStyle = shade(base, -0.18);
        ctx.stroke();
      }
      if (displaced.has(b)) {
        ctx.strokeStyle = c.muted;
        ctx.lineWidth = px(1);
        ctx.setLineDash([px(2), px(3)]);
        ctx.beginPath(); ctx.ellipse(b.x, b.y, w + px(4), hh + px(4), 0, 0, Math.PI * 2); ctx.stroke();
        ctx.setLineDash([]);
      }
      if (b.flash > 0) {
        ctx.globalAlpha = alpha * Math.min(1, b.flash * 1.5);
        ctx.lineWidth = px(2);
        ctx.strokeStyle = b.ours ? OURS[dk] : c.accent;
        ctx.beginPath();
        ctx.arc(b.x, b.y, rr + px(4) + (1 - b.flash) * px(6), 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.restore();
    };

    const ledge = (x: number, y: number, width: number, active = false) => {
      ctx.strokeStyle = c.rule;
      if (active) ctx.strokeStyle = c.accent;
      ctx.lineWidth = px(1.5);
      ctx.beginPath();
      ctx.moveTo(x - width / 2, y);
      ctx.lineTo(x + width / 2, y);
      ctx.stroke();
    };

    draw = () => {
      // The simulation stores drawing coordinates. Reproject them when the
      // canvas changes size, including while the reader has paused it.
      if (drawnWidth && (drawnWidth !== view.W || drawnPixel !== view.px)) {
        const sx = view.W / drawnWidth;
        const sy = view.px / drawnPixel;
        const bodies = new Set([...leads, ...directors, ...bench, ...room, ...moving, ...teams.flatMap(tm => tm.balls), ...decisions.flatMap(d => d.pieces)]);
        if (ours) bodies.add(ours);
        for (const b of bodies) {
          b.x *= sx; b.tx *= sx; b.vx *= sx;
          b.y *= sy; b.ty *= sy; b.vy *= sy;
        }
        for (const n of notes) { n.x *= sx; n.y *= sy; }
        for (const d of decisions) { d.x *= sx; d.y *= sy; }
      }
      drawnWidth = view.W;
      drawnPixel = view.px;
      clear(c.paper);
      const dk = dark() ? 1 : 0;
      const g = geo();
      ctx.font = `500 ${px(narrow ? 12 : 13)}px ${c.font}`;
      ctx.textBaseline = 'middle';

      // Leadership: a room that's open only during a meeting.
      const open = meeting ? Math.max(0, Math.min(1, (t - meeting) / 250, (meeting + OUT - t) / 250)) : 0;
      ctx.save();
      ctx.beginPath();
      ctx.roundRect(g.box.x, g.box.y, g.box.w, g.box.h, px(10));
      ctx.globalAlpha = 0.12 * open;
      ctx.fillStyle = c.accent;
      ctx.fill();
      ctx.globalAlpha = 1;
      ctx.strokeStyle = open > 0 ? c.accent : c.rule;
      ctx.lineWidth = px(1.5);
      ctx.stroke();
      ctx.restore();
      label(ctx, c, view.px, 'Senior leaders · four teams', g.box.x + px(12), g.box.y + px(14), c.muted, 'left');

      // The dial: time to the next meeting.
      const dx = g.box.x + g.box.w + px(narrow ? 20 : 28);
      const dy = g.box.y + g.box.h / 2;
      const dr = px(11);
      const f = meeting ? 1 : Math.min(1, Math.max(0, (t - lastMeet) / PERIOD));
      ctx.strokeStyle = c.rule;
      ctx.lineWidth = px(1.5);
      ctx.beginPath();
      ctx.arc(dx, dy, dr, 0, Math.PI * 2);
      ctx.stroke();
      if (f > 0) {
        ctx.fillStyle = c.accent;
        ctx.globalAlpha = meeting ? 0.9 : 0.55;
        ctx.beginPath();
        ctx.moveTo(dx, dy);
        ctx.arc(dx, dy, dr - px(2), -Math.PI / 2, -Math.PI / 2 + f * Math.PI * 2);
        ctx.closePath();
        ctx.fill();
        ctx.globalAlpha = 1;
      }

      ctx.font = `500 ${px(11)}px ${c.font}`;
      if (narrow) label(ctx, c, view.px, 'quarterly', Math.min(dx, view.W - ctx.measureText('quarterly').width / 2 - px(6)), dy + dr + px(12), c.muted);
      else label(ctx, c, view.px, 'quarterly round', dx + dr + px(8), dy, c.muted, 'left');
      ctx.font = `500 ${px(narrow ? 12 : 13)}px ${c.font}`;

      // The bench outside the room.
      ctx.strokeStyle = c.rule;
      ctx.lineWidth = px(1.5);
      ctx.beginPath();
      ctx.moveTo(g.cx - px(110), g.benchY);
      ctx.lineTo(g.cx + px(110), g.benchY);
      ctx.stroke();

      ctx.font = `500 ${px(narrow ? 11 : 13)}px ${c.font}`;
      label(ctx, c, view.px, 'Directors · two teams each · monthly', g.cx, g.directorsY - px(31), c.muted);
      label(ctx, c, view.px, 'Team leads · one team each', g.cx, g.leadsY - px(31), c.muted);
      for (const pair of [0, 1]) {
        const x = directorX(pair * 2);
        const active = t - directorRoundAt < 700;
        ledge(x, g.directorsY, directorWidth(), active);
        const clockX = x + directorWidth() / 2 - px(8);
        const clockY = g.directorsY - px(12);
        const progress = (t % MONTH) / MONTH;
        ctx.strokeStyle = c.rule; ctx.lineWidth = px(1);
        ctx.beginPath(); ctx.arc(clockX, clockY, px(7), 0, Math.PI * 2); ctx.stroke();
        ctx.strokeStyle = c.accent; ctx.lineWidth = px(2);
        ctx.beginPath(); ctx.arc(clockX, clockY, px(7), -Math.PI / 2, -Math.PI / 2 + (active ? 1 : progress) * Math.PI * 2); ctx.stroke();
      }
      teams.forEach((_, i) => ledge(teamX(i), g.leadsY, leadWidth()));

      // Brief paths make the scope of a decision visible: one, two or four lists.
      for (const decision of decisions) {
        ctx.save();
        ctx.globalAlpha = Math.min(0.5, (1500 - t + decision.at) / 1400);
        ctx.strokeStyle = decision.hue[dk]; ctx.lineWidth = px(1.5);
        for (const piece of decision.pieces) {
          ctx.beginPath(); ctx.moveTo(decision.x, decision.y);
          ctx.bezierCurveTo(decision.x, decision.y + px(24), piece.tx, piece.ty - px(24), piece.tx, piece.ty);
          ctx.stroke();
        }
        ctx.restore();
      }

      // The teams and their queues of work.
      teams.forEach((tm, i) => {
        const x = teamX(i);
        ctx.strokeStyle = c.rule;
        ctx.lineWidth = px(1.5);
        ctx.beginPath();
        ctx.moveTo(x - px(narrow ? 20 : 34), g.floor);
        ctx.lineTo(x + px(narrow ? 20 : 34), g.floor);
        ctx.stroke();
        const bottom = tm.balls[0];
        if (bottom && bottom.pop < 0 && !(changedPlansAt && t - changedPlansAt < 1600)) {
          ctx.strokeStyle = tm.hue[dk];
          ctx.lineWidth = px(2);
          ctx.beginPath();
          ctx.arc(bottom.x, bottom.y, r2() + px(4), -Math.PI / 2, -Math.PI / 2 + (tm.work / tm.pace) * Math.PI * 2);
          ctx.stroke();
        }
        for (const b of tm.balls) drawBody(b, r2(), dk);
      });
      teams.forEach((_,i)=>{
        ctx.font = `500 ${px(narrow ? 11 : 13)}px ${c.font}`;
        label(ctx,c,view.px,NAMES[i],teamX(i),g.floor+px(16),c.muted);
      });
      ctx.font = `${px(11)}px ${c.font}`;
      label(ctx,c,view.px,'Next job at the bottom · outlined jobs move back',view.W/2,g.floor+px(39),c.muted);

      // How long the delivery work has waited, with a tick at each meeting.
      const sw = view.W * 0.6;
      const sx = (view.W - sw) / 2;
      const sh = px(6);
      const span = 3 * PERIOD + PICK - OURS_AT;
      const at = (ms: number) => (Math.max(0, Math.min(ms - OURS_AT, span)) / span) * sw;
      ctx.save();
      ctx.globalAlpha = 0.35;
      ctx.fillStyle = c.rule;
      ctx.beginPath();
      ctx.roundRect(sx, g.stripY - sh / 2, sw, sh, sh / 2);
      ctx.fill();
      ctx.restore();
      const waited = pickedAt || t;
      if (waited > OURS_AT) {
        ctx.fillStyle = c.muted;
        ctx.beginPath();
        ctx.roundRect(sx, g.stripY - sh / 2, Math.max(sh, at(waited)), sh, sh / 2);
        ctx.fill();
      }
      ctx.font = `500 ${px(11)}px ${c.font}`;
      label(ctx, c, view.px, 'our wait', sx - px(10), g.stripY, c.muted, 'right');
      for (const [i,m] of [PERIOD, 2 * PERIOD, 3 * PERIOD].entries()) {
        ctx.fillStyle = t >= m ? c.accent : c.rule;
        ctx.fillRect(sx + at(m) - px(1), g.stripY - px(9), px(2), px(18));
        label(ctx, c, view.px, `Q${i+1}`, sx + at(m), g.stripY - px(16), c.muted);
      }
      if (pickedAt) {
        ctx.fillStyle = OURS[dk];
        ctx.beginPath();
        ctx.arc(sx + at(pickedAt), g.stripY, px(5), 0, Math.PI * 2);
        ctx.fill();
      }

      for (const b of [...bench, ...room, ...directors, ...leads, ...moving]) if (!b.ours) drawBody(b, b.tone === -1 ? r2() : R(), dk);
      if (ours && ours.alpha > 0) {
        drawBody(ours, R(), dk);
        if (stage !== 'done') {
          ctx.font = `600 ${px(12)}px ${c.font}`;
          const labelY = Math.max(g.box.y + g.box.h + px(14), ours.y - R() - px(10));
          label(ctx, c, view.px, 'Delivery dates', ours.x, labelY, OURS[dk]);
        }
      }

      ctx.font = `500 ${px(12)}px ${c.font}`;
      for (const n of notes) {
        ctx.save();
        ctx.globalAlpha = Math.max(0, Math.min(1, n.life / 300, (1300 - n.life) / 150));
        const nx = Math.min(n.x, view.W - ctx.measureText(n.text).width - px(8));
        label(ctx, c, view.px, n.text, nx, n.y, c.ink, 'left');
        ctx.restore();
      }
    };

    reset();
    // Use the shared offscreen, pause and reduced-motion behaviour. The simulation
    // keeps its own cycle; this clock only supplies elapsed time to its fixed steps.
    const CLOCK = 60000;
    const SPEED = 0.8; // A full cycle takes about 34 seconds.
    let previous = 0;
    let wasStill = false;
    loop(figure, CLOCK, 7000, clock => {
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still) {
        reset();
        pending = 7000 * 1.6;
      } else if (!wasStill) {
        pending += ((clock - previous + CLOCK) % CLOCK) * SPEED;
      }
      wasStill = still;
      previous = clock;
      while (pending >= TICK) {
        pending -= TICK;
        step();
      }
      describe();
      draw();
    });
  }
</script>
