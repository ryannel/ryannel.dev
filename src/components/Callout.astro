---
/**
 * A restrained aside for the recurring shapes these notes take.
 * Usage in .mdx (no import needed — see src/pages/writing/[...slug].astro):
 *   <Callout type="surprise">Text.</Callout>
 *   <Callout label="Caveat">Text.</Callout>
 */
type CalloutType = 'hypothesis' | 'surprise' | 'failed' | 'update' | 'note';

interface Props {
  type?: CalloutType;
  /** Overrides the default label for the type. */
  label?: string;
  /** Set only by the dev-only editor (scripts/editor/stamp.mjs); never in a build. */
  'data-src'?: string;
}

const LABELS: Record<CalloutType, string> = {
  hypothesis: 'Current hypothesis',
  surprise: 'What surprised me',
  failed: "What didn’t work",
  update: 'Update',
  note: 'Note',
};

const { type = 'note', label } = Astro.props;
---

<!--
  role="note" rather than <aside>'s implicit "complementary": this is an aside
  within an article, not a landmark alongside it, and a complementary landmark
  nested inside <main> is reported as a fault by every auditing tool.
-->
<aside role="note" class={`callout callout-${type}`} data-src={Astro.props['data-src']}>
  <p class="callout-label">{label ?? LABELS[type]}</p>
  <slot />
</aside>
